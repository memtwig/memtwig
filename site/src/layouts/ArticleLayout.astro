---
import "@/styles/global.css";
import SiteHeader from "@/components/SiteHeader.astro";
import SiteFooter from "@/components/SiteFooter.astro";

interface Props {
  title: string;
  description: string;
  path: string;
  faqs?: Array<{ q: string; a: string }>;
  noindex?: boolean;
  /** Visible "last updated" date; also used as dateModified. Set false to hide (e.g. 404). */
  updated?: string | false;
}

const { title, description, path, faqs = [], noindex = false, updated = "2026-11-24" } = Astro.props;
const siteUrl = "https://memtwig.com";
const ogImage = `${siteUrl}/og-image.png?v=2`;
const canonicalUrl = `${siteUrl}${path}`;
const docsUrl = "https://github.com/memtwig/memtwig/tree/main/docs";

const graph: Record<string, unknown>[] = [
  {
    "@type": "TechArticle",
    "@id": `${canonicalUrl}#article`,
    headline: title,
    description,
    url: canonicalUrl,
    datePublished: "2026-11-23",
    dateModified: updated || "2026-11-24",
    inLanguage: "en",
    image: {
      "@type": "ImageObject",
      url: ogImage,
      width: 1200,
      height: 630,
    },
    author: {
      "@type": "Person",
      "@id": "https://vittoriocompagno.com/#person",
      name: "Vittorio Compagno",
      url: "https://vittoriocompagno.com",
    },
    publisher: { "@id": "https://vittoriocompagno.com/#person" },
    about: { "@id": `${siteUrl}/#software` },
  },
];

if (faqs.length > 0) {
  graph.push({
    "@type": "FAQPage",
    "@id": `${canonicalUrl}#faq`,
    mainEntity: faqs.map((item) => ({
      "@type": "Question",
      name: item.q,
      acceptedAnswer: {
        "@type": "Answer",
        text: item.a,
      },
    })),
  });
}

const jsonLd = {
  "@context": "https://schema.org",
  "@graph": graph,
};
---

<!doctype html>
<html lang="en" class="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title} — memtwig</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />
    {noindex && <meta name="robots" content="noindex, follow" />}
    <link rel="alternate" type="text/markdown" href={`${siteUrl}/llms.txt`} title="LLMs summary" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    <meta property="og:type" content="article" />
    <meta property="og:site_name" content="memtwig" />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:title" content={`${title} — memtwig`} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:creator" content="@toriodev" />
    <meta name="twitter:title" content={`${title} — memtwig`} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  </head>
  <body class="min-h-screen bg-background text-foreground">
    <SiteHeader currentPath={path} />

    <main class="mx-auto max-w-6xl px-5 pt-16 pb-24 sm:px-8 sm:pt-24 sm:pb-32">
      <slot />

      {updated && (
        <p class="mt-16 text-xs text-zinc-500">
          Last updated <time datetime={updated}>{new Date(`${updated}T00:00:00Z`).toLocaleDateString("en-US", { year: "numeric", month: "long", day: "numeric", timeZone: "UTC" })}</time>
        </p>
      )}

      {faqs.length > 0 && (
        <section class="mt-24 grid gap-10 border-t border-white/[0.08] pt-16 lg:grid-cols-12">
          <div class="lg:col-span-4">
            <h2 class="text-4xl font-medium tracking-[-0.035em] text-white sm:text-5xl">Questions</h2>
            <p class="mt-3 text-base leading-relaxed text-zinc-400">
              Short answers about setup, privacy, and workflow fit.
            </p>
            <a
              href={docsUrl}
              target="_blank"
              rel="noreferrer"
              class="mt-5 inline-flex items-center gap-1.5 text-sm font-medium text-white transition-colors hover:text-[#58cc7d]"
            >
              Read the docs →
            </a>
          </div>

          <div class="divide-y divide-white/[0.08] lg:col-span-8">
            {faqs.map((item) => (
              <details class="group py-5 first:pt-0">
                <summary class="flex cursor-pointer list-none items-center justify-between gap-4 text-base font-medium text-white sm:text-lg [&::-webkit-details-marker]:hidden">
                  <span>{item.q}</span>
                  <span class="shrink-0 text-xl font-normal text-zinc-400 transition-transform duration-150 group-open:rotate-45">+</span>
                </summary>
                <p class="mt-3 max-w-2xl text-sm leading-relaxed text-zinc-400 sm:text-base">{item.a}</p>
              </details>
            ))}
          </div>
        </section>
      )}
    </main>

    <SiteFooter />
  </body>
</html>
