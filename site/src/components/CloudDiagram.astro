---
// Schematic dark monochrome architecture diagram for Memtwig Cloud
---

<div class="overflow-hidden rounded-lg border border-border bg-[#0b0b0e]">
  <svg
    viewBox="0 0 880 240"
    class="block w-full h-auto"
    style='font-family: "Plus Jakarta Sans Variable", "Plus Jakarta Sans", system-ui, sans-serif;'
    role="img"
    aria-label="Diagram showing Git repos and always-on agents connecting to Memtwig Cloud Curator, Hosted HTTPS MCP, and Managed Embeddings, outputting reviewable PRs and diffs"
  >
    <defs>
      <pattern id="grid-cloud" width="20" height="20" patternUnits="userSpaceOnUse">
        <circle cx="1" cy="1" r="0.7" fill="#1b1b21" />
      </pattern>
    </defs>
    <rect width="880" height="240" fill="url(#grid-cloud)" />

    <!-- Left -> Center wires -->
    <path d="M 230 71 C 266 71, 266 90, 302 90" fill="none" stroke="#34d399" stroke-width="1.5" stroke-opacity="0.85" />
    <circle cx="302" cy="90" r="2.5" fill="#34d399" />

    <path d="M 230 169 C 266 169, 266 150, 302 150" fill="none" stroke="#34d399" stroke-width="1.5" stroke-opacity="0.75" />
    <circle cx="302" cy="150" r="2.5" fill="#34d399" />

    <!-- Center -> Right wire -->
    <line x1="586" y1="120" x2="654" y2="120" stroke="#34d399" stroke-width="1.5" stroke-opacity="0.85" />
    <circle cx="654" cy="120" r="2.5" fill="#34d399" />

    <!-- Left Source 1: Your Git Repos -->
    <rect x="24" y="34" width="206" height="74" rx="6" fill="#121217" stroke="#2f2f38" stroke-width="1" />
    <circle cx="41" cy="56" r="3" fill="#34d399" />
    <text x="51" y="60" fill="#f4f4f5" font-size="12.5" font-weight="500">Your Git Repos</text>
    <text x="41" y="84" fill="#8a8a93" font-size="11">GitHub / GitLab App</text>

    <!-- Left Source 2: Always-on Agents -->
    <rect x="24" y="132" width="206" height="74" rx="6" fill="#121217" stroke="#2f2f38" stroke-width="1" />
    <circle cx="41" cy="154" r="3" fill="#34d399" />
    <text x="51" y="158" fill="#f4f4f5" font-size="12.5" font-weight="500">Always-on Agents</text>
    <text x="41" y="182" fill="#8a8a93" font-size="11">Grok Bot · OpenBot · Team</text>

    <!-- Center Hub: Memtwig Cloud -->
    <rect x="302" y="26" width="284" height="188" rx="6" fill="#141418" stroke="#3a3a44" stroke-width="1.2" />
    <circle cx="320" cy="48" r="3" fill="#34d399" />
    <text x="330" y="52" fill="#fafafa" font-size="13.5" font-weight="600">Memtwig Cloud</text>

    <!-- Row 1: Cloud Curator -->
    <rect x="318" y="66" width="252" height="40" rx="5" fill="#0d0d11" stroke="#282830" stroke-width="1" />
    <text x="332" y="90" fill="#f4f4f5" font-size="12" font-weight="500">Cloud Curator</text>
    <text x="556" y="90" text-anchor="end" fill="#34d399" font-size="10.5">nightly diff</text>

    <!-- Row 2: Hosted HTTPS /mcp -->
    <rect x="318" y="114" width="252" height="40" rx="5" fill="#0d0d11" stroke="#282830" stroke-width="1" />
    <text x="332" y="138" fill="#f4f4f5" font-size="12" font-weight="500">Hosted HTTPS /mcp</text>
    <text x="556" y="138" text-anchor="end" fill="#8a8a93" font-size="10.5">RBAC + audit</text>

    <!-- Row 3: Managed Embeddings -->
    <rect x="318" y="162" width="252" height="40" rx="5" fill="#0d0d11" stroke="#282830" stroke-width="1" />
    <text x="332" y="186" fill="#f4f4f5" font-size="12" font-weight="500">Managed Embeddings</text>
    <text x="556" y="186" text-anchor="end" fill="#8a8a93" font-size="10.5">1024d auto</text>

    <!-- Right Output: PRs & Studio UI -->
    <rect x="654" y="72" width="202" height="96" rx="6" fill="#121217" stroke="#2f2f38" stroke-width="1" />
    <text x="670" y="98" fill="#f4f4f5" font-size="13" font-weight="500">PRs &amp; Studio UI</text>
    <text x="670" y="117" fill="#8a8a93" font-size="10.5">Approve diffs · zero lock-in</text>
    <rect x="670" y="132" width="68" height="22" rx="4" fill="#fafafa" />
    <text x="704" y="147" text-anchor="middle" fill="#09090b" font-size="11" font-weight="600">Approve</text>
  </svg>
</div>
