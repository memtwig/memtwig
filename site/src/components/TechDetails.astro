---
// What the bento leaves out, from the README, docs/architecture.md, docs/harnesses.md and internal/mcp (v1.6.0).
const h3 = "text-base font-medium text-white sm:text-lg";
const pre = "code-surface m-0 mt-3 overflow-x-auto rounded-2xl border border-white/[0.06] bg-[#111113] p-4 text-xs leading-[1.8] whitespace-pre sm:text-[13px]";

const tools = [
  ["memory_search", "hybrid BM25 + vector search across the vaults active for this folder"],
  ["memory_read", "full Markdown of a note, with its owner lock header"],
  ["memory_write", "direct write, only where the vault allows it and the note is not owner-locked"],
  ["memory_delete", "direct delete under the same rules; never archives or decision logs"],
  ["memory_propose", "queues a create, append, update or delete for human diff review"],
  ["memory_decide", "logs a confirmed decision in decisions/YYYY-MM.md and links the project note"],
  ["memory_status", "active vaults, write mode (direct, propose, readonly), open proposals"],
];
const hooks = [
  ["Claude Code", "UserPromptSubmit and SessionStart run memtwig hook claude"],
  ["Antigravity", "PreInvocation returns injectSteps; SessionStart adds your identity file"],
  ["Per prompt", "relevant snippets and a correction nudge, gated against noise"],
];
const layout = [
  ["projects/", "active project facts and state"],
  ["decisions/", "monthly logs, decisions/YYYY-MM.md"],
  ["persona/", "preferences, identity, style rules"],
  [".curator/", "proposals.json and history.jsonl"],
  ["memtwig.toml", "vault defaults such as max_note_bytes"],
];
---

<div class="grid gap-10 [&>*]:min-w-0">
  <section>
    <h3 class={h3}>MCP tools</h3>
    <ul class="mt-3 divide-y divide-white/[0.06]" role="list">
      {
        tools.map(([t, d]) => (
          <li class="grid gap-1 py-3 sm:grid-cols-[10rem_minmax(0,1fr)] sm:gap-4">
            <span class="code-surface text-sm text-[#58cc7d]">{t}</span>
            <span class="text-sm text-zinc-400">{d}</span>
          </li>
        ))
      }
    </ul>
    <p class="mt-3 text-sm text-zinc-400">Over stdio with memtwig mcp, or Streamable HTTP with RBAC tokens and an audit log with memtwig serve.</p>
  </section>

  <section>
    <h3 class={h3}>Hooks</h3>
    <dl class="mt-3 divide-y divide-white/[0.06]">
      {
        hooks.map(([h, d]) => (
          <div class="grid gap-1 py-3 sm:grid-cols-[10rem_minmax(0,1fr)] sm:gap-4">
            <dt class="text-sm text-zinc-200">{h}</dt>
            <dd class="code-surface text-xs leading-relaxed text-zinc-400">{d}</dd>
          </div>
        ))
      }
    </dl>
  </section>

  <section>
    <h3 class={h3}>Search</h3>
    <p class="mt-1 text-sm leading-relaxed text-zinc-400">
      A local SQLite FTS5 index, rebuilt from the Markdown at any time, ranks notes with BM25. Optional 1024-dim embeddings (Ollama, OpenRouter, DeepInfra, OpenAI, Cloudflare) are fused with reciprocal rank fusion.
    </p>
    <pre class={pre}><code><span class="tok-cmd">memtwig</span> <span class="text-zinc-200">index</span>
<span class="tok-cmd">memtwig</span> <span class="text-zinc-200">search</span> <span class="tok-str">"deploy"</span></code></pre>
  </section>

  <section>
    <h3 class={h3}>Curation</h3>
    <pre class={pre}><code><span class="tok-cmd">memtwig</span> <span class="text-zinc-200">check</span>                          <span class="tok-com"># lint, secret scan, 8 KB soft cap</span>
<span class="tok-cmd">memtwig</span> <span class="text-zinc-200">decide</span> <span class="tok-str">"Moved API to Fly.io"</span> <span class="tok-flag">--project</span> <span class="text-zinc-200">acme</span>
<span class="tok-cmd">memtwig</span> <span class="text-zinc-200">invalidate projects/infra.md</span> <span class="tok-flag">--match</span> <span class="tok-str">"old-heroku"</span>
<span class="tok-cmd">memtwig</span> <span class="text-zinc-200">curate</span> <span class="tok-flag">--candidates --json</span>       <span class="tok-com"># contradiction pairs for your agent</span>
<span class="tok-cmd">memtwig</span> <span class="text-zinc-200">proposal list</span></code></pre>
  </section>

  <section>
    <h3 class={h3}>Vault layout</h3>
    <dl class="mt-3 divide-y divide-white/[0.06]">
      {
        layout.map(([p, d]) => (
          <div class="grid gap-1 py-2.5 sm:grid-cols-[10rem_minmax(0,1fr)] sm:gap-4">
            <dt class="code-surface text-sm text-zinc-200">{p}</dt>
            <dd class="text-sm text-zinc-400">{d}</dd>
          </div>
        ))
      }
    </dl>
  </section>
</div>
