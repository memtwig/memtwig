---
interface Props {
  variant: "mem0" | "claude-md" | "mcp";
}

const { variant } = Astro.props;
---

<div class="grid gap-4 md:grid-cols-2">
  {variant === "mem0" && (
    <>
      <div class="rounded-[24px] border border-[#58cc7d]/30 bg-[#17211a] p-6 sm:p-7">
        <div class="flex items-center justify-between gap-3">
          <span class="inline-flex items-center gap-2 text-lg font-medium text-white">
            <span class="size-2 rounded-full bg-[#58cc7d]" aria-hidden="true"></span>
            memtwig
          </span>
          <span class="text-xs text-[#7ee09e]">local · git-native</span>
        </div>
        <div class="mt-5 space-y-2.5">
          <div class="rounded-xl border border-white/10 bg-[#141415] px-4 py-3">
            <div class="text-sm font-medium text-white">Workspace</div>
            <div class="text-xs text-zinc-400">~/work/acme · automatic cwd &amp; remote routing</div>
          </div>
          <div class="rounded-xl border border-white/10 bg-[#141415] px-4 py-3">
            <div class="text-sm font-medium text-white">Git Markdown Vault</div>
            <div class="text-xs text-zinc-400">Readable .md files in your repo</div>
          </div>
          <div class="flex items-center justify-between gap-3 rounded-xl border border-[#58cc7d]/30 bg-[#141415] px-4 py-3">
            <div>
              <div class="text-sm font-medium text-white">Diff Approval + Local Index</div>
              <div class="text-xs text-[#7ee09e]">Works 100% offline · zero cloud DB</div>
            </div>
            <span class="rounded-full bg-white px-3 py-1 text-xs font-medium text-[#141415]">Approve</span>
          </div>
        </div>
      </div>

      <div class="rounded-[24px] border border-white/[0.08] bg-[#1c1c1f] p-6 sm:p-7">
        <div class="flex items-center justify-between gap-3">
          <span class="text-lg font-medium text-zinc-300">Mem0</span>
          <span class="text-xs text-zinc-500">cloud · vector API</span>
        </div>
        <div class="mt-5 space-y-2.5">
          <div class="rounded-xl border border-white/[0.06] bg-[#141415] px-4 py-3">
            <div class="text-sm font-medium text-zinc-200">App SDK</div>
            <div class="text-xs text-zinc-500">Manual tenant &amp; user IDs</div>
          </div>
          <div class="rounded-xl border border-white/[0.06] bg-[#141415] px-4 py-3">
            <div class="text-sm font-medium text-zinc-200">Cloud LLM Extractor</div>
            <div class="text-xs text-zinc-500">Requires API key &amp; network</div>
          </div>
          <div class="rounded-xl border border-dashed border-white/10 bg-[#141415]/60 px-4 py-3">
            <div class="text-sm font-medium text-zinc-400">Vector + Graph DB</div>
            <div class="text-xs text-zinc-500">Background overwrites · no Git diff</div>
          </div>
        </div>
      </div>
    </>
  )}

  {variant === "claude-md" && (
    <>
      <div class="rounded-[24px] border border-[#58cc7d]/30 bg-[#17211a] p-6 sm:p-7">
        <div class="flex items-center justify-between gap-3">
          <span class="inline-flex items-center gap-2 text-lg font-medium text-white">
            <span class="size-2 rounded-full bg-[#58cc7d]" aria-hidden="true"></span>
            memtwig
          </span>
          <span class="text-xs text-[#7ee09e]">top-3 snippets</span>
        </div>
        <div class="mt-5 space-y-2.5">
          <div class="grid grid-cols-2 gap-2.5">
            <div class="rounded-xl border border-white/10 bg-[#141415] px-4 py-3">
              <div class="text-sm font-medium text-white">Vault</div>
              <div class="text-xs text-zinc-400">109 curated notes</div>
            </div>
            <div class="rounded-xl border border-white/10 bg-[#141415] px-4 py-3">
              <div class="text-sm font-medium text-white">Top-K Index</div>
              <div class="text-xs text-[#7ee09e]">~400 chars / snippet</div>
            </div>
          </div>
          <div class="rounded-xl border border-white/10 bg-[#141415] px-4 py-3">
            <div class="flex items-center justify-between text-xs">
              <span class="font-medium text-white">Prompt context</span>
              <span class="text-zinc-400">lean · per turn</span>
            </div>
            <div class="mt-2 h-2 w-full overflow-hidden rounded-full bg-white/10">
              <div class="h-full w-1/5 rounded-full bg-[#58cc7d]"></div>
            </div>
          </div>
          <div class="flex flex-wrap gap-2 pt-1 text-xs text-zinc-200">
            <span class="rounded-full border border-white/10 bg-[#141415] px-3 py-1">Claude Code</span>
            <span class="rounded-full border border-white/10 bg-[#141415] px-3 py-1">Cursor</span>
            <span class="rounded-full border border-white/10 bg-[#141415] px-3 py-1">Codex</span>
          </div>
        </div>
      </div>

      <div class="rounded-[24px] border border-white/[0.08] bg-[#1c1c1f] p-6 sm:p-7">
        <div class="flex items-center justify-between gap-3">
          <span class="text-lg font-medium text-zinc-300">Static rules files</span>
          <span class="text-xs text-zinc-500">full file loaded</span>
        </div>
        <div class="mt-5 space-y-2.5">
          <div class="grid grid-cols-3 gap-2 text-center text-xs text-zinc-300">
            <div class="rounded-xl border border-white/[0.06] bg-[#141415] py-3">CLAUDE.md</div>
            <div class="rounded-xl border border-white/[0.06] bg-[#141415] py-3">AGENTS.md</div>
            <div class="rounded-xl border border-white/[0.06] bg-[#141415] py-3">.cursorrules</div>
          </div>
          <div class="rounded-xl border border-white/[0.06] bg-[#141415] px-4 py-3">
            <div class="flex items-center justify-between text-xs">
              <span class="font-medium text-zinc-300">Prompt context</span>
              <span class="text-zinc-500">100% loaded every turn</span>
            </div>
            <div class="mt-2 h-2 w-full rounded-full bg-zinc-600"></div>
          </div>
          <div class="rounded-xl border border-dashed border-white/10 bg-[#141415]/60 px-4 py-2.5 text-center text-xs text-zinc-500">
            Manual copy-paste · duplicated per repo
          </div>
        </div>
      </div>
    </>
  )}

  {variant === "mcp" && (
    <>
      <div class="rounded-[24px] border border-[#58cc7d]/30 bg-[#17211a] p-6 sm:p-7">
        <div class="flex items-center justify-between gap-3">
          <span class="inline-flex items-center gap-2 text-lg font-medium text-white">
            <span class="size-2 rounded-full bg-[#58cc7d]" aria-hidden="true"></span>
            Local stdio
          </span>
          <span class="text-xs text-[#7ee09e]">memtwig mcp</span>
        </div>
        <div class="mt-5 space-y-2.5">
          <div class="flex flex-wrap gap-2 text-xs text-zinc-200">
            <span class="rounded-full border border-white/10 bg-[#141415] px-3 py-1">Claude Code</span>
            <span class="rounded-full border border-white/10 bg-[#141415] px-3 py-1">Cursor</span>
            <span class="rounded-full border border-white/10 bg-[#141415] px-3 py-1">Codex</span>
          </div>
          <div class="rounded-xl border border-white/10 bg-[#141415] px-4 py-3">
            <div class="text-sm font-medium text-white">memtwig mcp</div>
            <div class="text-xs text-zinc-400">6 scoped tools · zero network calls</div>
          </div>
          <div class="rounded-xl border border-[#58cc7d]/30 bg-[#141415] px-4 py-3">
            <div class="text-sm font-medium text-white">Local Vaults</div>
            <div class="text-xs text-[#7ee09e]">cwd &amp; git remote isolation</div>
          </div>
        </div>
      </div>

      <div class="rounded-[24px] border border-white/[0.08] bg-[#1c1c1f] p-6 sm:p-7">
        <div class="flex items-center justify-between gap-3">
          <span class="inline-flex items-center gap-2 text-lg font-medium text-white">
            <span class="size-2 rounded-full bg-[#6bb5ff]" aria-hidden="true"></span>
            Team HTTP
          </span>
          <span class="text-xs text-[#6bb5ff]">memtwig serve</span>
        </div>
        <div class="mt-5 space-y-2.5">
          <div class="rounded-xl border border-white/[0.07] bg-[#141415] px-4 py-3">
            <div class="text-sm font-medium text-white">Team Agents</div>
            <div class="text-xs text-zinc-400">POST /mcp · per-bot Bearer auth</div>
          </div>
          <div class="rounded-xl border border-white/[0.07] bg-[#141415] px-4 py-3">
            <div class="text-sm font-medium text-white">RBAC Gate</div>
            <div class="text-xs text-[#6bb5ff]">role + vault + path globs</div>
          </div>
          <div class="grid grid-cols-2 gap-2.5">
            <div class="rounded-xl border border-white/[0.07] bg-[#141415] px-4 py-2.5">
              <div class="text-xs font-medium text-white">Audit Log</div>
              <div class="text-xs text-zinc-500">audit.jsonl</div>
            </div>
            <div class="rounded-xl border border-white/[0.07] bg-[#141415] px-4 py-2.5">
              <div class="text-xs font-medium text-white">Proposals</div>
              <div class="text-xs text-zinc-500">diff queue</div>
            </div>
          </div>
        </div>
      </div>
    </>
  )}
</div>
