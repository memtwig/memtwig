---
interface Props {
  variant: "mem0" | "claude-md" | "mcp";
}

const { variant } = Astro.props;
---

<div class="overflow-hidden rounded-lg border border-border bg-[#0b0b0e]">
  {variant === "mem0" && (
    <svg
      viewBox="0 0 880 260"
      class="block w-full h-auto"
      style='font-family: "Plus Jakarta Sans Variable", "Plus Jakarta Sans", system-ui, sans-serif;'
      role="img"
      aria-label="Architecture comparison between memtwig (local Git Markdown vaults with diff approval) and Mem0 (cloud LLM extractor and vector database)"
    >
      <defs>
        <pattern id="grid-vs-mem0" width="20" height="20" patternUnits="userSpaceOnUse">
          <circle cx="1" cy="1" r="0.7" fill="#1b1b21" />
        </pattern>
      </defs>
      <rect width="880" height="260" fill="url(#grid-vs-mem0)" />

      <!-- Center divider -->
      <line x1="440" y1="22" x2="440" y2="238" stroke="#232328" stroke-width="1" stroke-dasharray="4 4" />
      <rect x="424" y="122" width="32" height="22" rx="4" fill="#0b0b0e" stroke="#232328" stroke-width="1" />
      <text x="440" y="137" text-anchor="middle" fill="#8a8a93" font-size="11" font-weight="500">vs</text>

      <!-- Left: memtwig -->
      <circle cx="38" cy="30" r="3" fill="#34d399" />
      <text x="48" y="34" fill="#f4f4f5" font-size="12.5" font-weight="600">memtwig</text>
      <text x="408" y="34" text-anchor="end" fill="#8a8a93" font-size="11">local · git-native</text>

      <rect x="32" y="50" width="376" height="44" rx="6" fill="#121217" stroke="#2f2f38" stroke-width="1" />
      <text x="48" y="76" fill="#f4f4f5" font-size="12.5" font-weight="500">Workspace</text>
      <text x="392" y="76" text-anchor="end" fill="#8a8a93" font-size="11">~/work/acme · cwd routed</text>

      <line x1="220" y1="94" x2="220" y2="114" stroke="#34d399" stroke-width="1.5" stroke-opacity="0.85" />
      <circle cx="220" cy="114" r="2.5" fill="#34d399" />

      <rect x="32" y="114" width="376" height="44" rx="6" fill="#121217" stroke="#2f2f38" stroke-width="1" />
      <text x="48" y="140" fill="#f4f4f5" font-size="12.5" font-weight="500">Git Markdown Vault</text>
      <text x="392" y="140" text-anchor="end" fill="#8a8a93" font-size="11">plain .md files</text>

      <line x1="220" y1="158" x2="220" y2="178" stroke="#34d399" stroke-width="1.5" stroke-opacity="0.85" />
      <circle cx="220" cy="178" r="2.5" fill="#34d399" />

      <rect x="32" y="178" width="376" height="54" rx="6" fill="#121217" stroke="#3a3a44" stroke-width="1" />
      <text x="48" y="201" fill="#f4f4f5" font-size="12.5" font-weight="500">Diff Approval + Local Index</text>
      <text x="48" y="219" fill="#34d399" font-size="11">offline · zero cloud DB</text>
      <rect x="328" y="193" width="66" height="24" rx="4" fill="#fafafa" />
      <text x="361" y="209" text-anchor="middle" fill="#09090b" font-size="11" font-weight="600">Approve</text>

      <!-- Right: Mem0 -->
      <circle cx="478" cy="30" r="3" fill="#52525b" />
      <text x="488" y="34" fill="#a1a1aa" font-size="12.5" font-weight="600">Mem0</text>
      <text x="848" y="34" text-anchor="end" fill="#71717a" font-size="11">cloud · vector API</text>

      <rect x="472" y="50" width="376" height="44" rx="6" fill="#0f0f13" stroke="#232329" stroke-width="1" />
      <text x="488" y="76" fill="#d4d4d8" font-size="12.5" font-weight="500">App SDK</text>
      <text x="832" y="76" text-anchor="end" fill="#71717a" font-size="11">manual tenant IDs</text>

      <line x1="660" y1="94" x2="660" y2="114" stroke="#3f3f46" stroke-width="1.4" />

      <rect x="472" y="114" width="376" height="44" rx="6" fill="#0f0f13" stroke="#232329" stroke-width="1" />
      <text x="488" y="140" fill="#d4d4d8" font-size="12.5" font-weight="500">Cloud LLM Extractor</text>
      <text x="832" y="140" text-anchor="end" fill="#71717a" font-size="11">API key required</text>

      <line x1="660" y1="158" x2="660" y2="178" stroke="#3f3f46" stroke-width="1.4" />

      <rect x="472" y="178" width="376" height="54" rx="6" fill="#0d0d10" stroke="#232329" stroke-width="1" stroke-dasharray="4 3" />
      <text x="488" y="201" fill="#a1a1aa" font-size="12.5" font-weight="500">Vector + Graph DB</text>
      <text x="488" y="219" fill="#71717a" font-size="11">background overwrite · no Git diff</text>
    </svg>
  )}

  {variant === "claude-md" && (
    <svg
      viewBox="0 0 880 260"
      class="block w-full h-auto"
      style='font-family: "Plus Jakarta Sans Variable", "Plus Jakarta Sans", system-ui, sans-serif;'
      role="img"
      aria-label="Context window comparison between memtwig top-K snippets shared across tools and static CLAUDE.md files loaded in full every turn"
    >
      <defs>
        <pattern id="grid-vs-claudemd" width="20" height="20" patternUnits="userSpaceOnUse">
          <circle cx="1" cy="1" r="0.7" fill="#1b1b21" />
        </pattern>
      </defs>
      <rect width="880" height="260" fill="url(#grid-vs-claudemd)" />

      <!-- Center divider -->
      <line x1="440" y1="22" x2="440" y2="238" stroke="#232328" stroke-width="1" stroke-dasharray="4 4" />
      <rect x="424" y="122" width="32" height="22" rx="4" fill="#0b0b0e" stroke="#232328" stroke-width="1" />
      <text x="440" y="137" text-anchor="middle" fill="#8a8a93" font-size="11" font-weight="500">vs</text>

      <!-- Left: memtwig -->
      <circle cx="38" cy="30" r="3" fill="#34d399" />
      <text x="48" y="34" fill="#f4f4f5" font-size="12.5" font-weight="600">memtwig</text>
      <text x="408" y="34" text-anchor="end" fill="#34d399" font-size="11">top-3 snippets</text>

      <rect x="32" y="50" width="166" height="48" rx="6" fill="#121217" stroke="#2f2f38" stroke-width="1" />
      <text x="46" y="71" fill="#f4f4f5" font-size="12" font-weight="500">Vault</text>
      <text x="46" y="87" fill="#8a8a93" font-size="10.5">109 curated notes</text>

      <line x1="198" y1="74" x2="232" y2="74" stroke="#34d399" stroke-width="1.5" />
      <circle cx="232" cy="74" r="2.5" fill="#34d399" />

      <rect x="232" y="50" width="176" height="48" rx="6" fill="#121217" stroke="#2f2f38" stroke-width="1" />
      <text x="246" y="71" fill="#f4f4f5" font-size="12" font-weight="500">Top-K Index</text>
      <text x="246" y="87" fill="#34d399" font-size="10.5">~400 chars per snippet</text>

      <line x1="320" y1="98" x2="320" y2="116" stroke="#34d399" stroke-width="1.5" />

      <rect x="32" y="116" width="376" height="52" rx="6" fill="#121217" stroke="#3a3a44" stroke-width="1" />
      <text x="48" y="137" fill="#f4f4f5" font-size="12" font-weight="500">Prompt context</text>
      <text x="392" y="137" text-anchor="end" fill="#8a8a93" font-size="10.5">lean · per turn</text>
      <rect x="48" y="148" width="344" height="8" rx="2" fill="#1c1c22" />
      <rect x="48" y="148" width="68" height="8" rx="2" fill="#34d399" />

      <!-- Cross-tool wires & chips -->
      <line x1="90" y1="168" x2="90" y2="188" stroke="#2e2e36" stroke-width="1.2" />
      <line x1="220" y1="168" x2="220" y2="188" stroke="#2e2e36" stroke-width="1.2" />
      <line x1="350" y1="168" x2="350" y2="188" stroke="#2e2e36" stroke-width="1.2" />

      <rect x="32" y="188" width="116" height="36" rx="5" fill="#121217" stroke="#2a2a32" stroke-width="1" />
      <text x="90" y="210" text-anchor="middle" fill="#e4e4e7" font-size="11.5" font-weight="500">Claude Code</text>

      <rect x="162" y="188" width="116" height="36" rx="5" fill="#121217" stroke="#2a2a32" stroke-width="1" />
      <text x="220" y="210" text-anchor="middle" fill="#e4e4e7" font-size="11.5" font-weight="500">Cursor</text>

      <rect x="292" y="188" width="116" height="36" rx="5" fill="#121217" stroke="#2a2a32" stroke-width="1" />
      <text x="350" y="210" text-anchor="middle" fill="#e4e4e7" font-size="11.5" font-weight="500">Codex</text>

      <!-- Right: Static rules -->
      <circle cx="478" cy="30" r="3" fill="#52525b" />
      <text x="488" y="34" fill="#a1a1aa" font-size="12.5" font-weight="600">Static rules files</text>
      <text x="848" y="34" text-anchor="end" fill="#71717a" font-size="11">full file loaded</text>

      <rect x="472" y="50" width="118" height="48" rx="6" fill="#0f0f13" stroke="#232329" stroke-width="1" />
      <text x="531" y="78" text-anchor="middle" fill="#a1a1aa" font-size="11.5" font-weight="500">CLAUDE.md</text>

      <rect x="601" y="50" width="118" height="48" rx="6" fill="#0f0f13" stroke="#232329" stroke-width="1" />
      <text x="660" y="78" text-anchor="middle" fill="#a1a1aa" font-size="11.5" font-weight="500">AGENTS.md</text>

      <rect x="730" y="50" width="118" height="48" rx="6" fill="#0f0f13" stroke="#232329" stroke-width="1" />
      <text x="789" y="78" text-anchor="middle" fill="#a1a1aa" font-size="11.5" font-weight="500">.cursorrules</text>

      <line x1="531" y1="98" x2="531" y2="116" stroke="#3f3f46" stroke-width="1.2" />
      <line x1="660" y1="98" x2="660" y2="116" stroke="#3f3f46" stroke-width="1.2" />
      <line x1="789" y1="98" x2="789" y2="116" stroke="#3f3f46" stroke-width="1.2" />

      <rect x="472" y="116" width="376" height="52" rx="6" fill="#0f0f13" stroke="#232329" stroke-width="1" />
      <text x="488" y="137" fill="#d4d4d8" font-size="12" font-weight="500">Prompt context</text>
      <text x="832" y="137" text-anchor="end" fill="#71717a" font-size="10.5">100% loaded every turn</text>
      <rect x="488" y="148" width="344" height="8" rx="2" fill="#52525b" />

      <rect x="472" y="188" width="376" height="36" rx="6" fill="#0d0d10" stroke="#232329" stroke-width="1" stroke-dasharray="4 3" />
      <text x="660" y="210" text-anchor="middle" fill="#71717a" font-size="11.5">Manual copy-paste · duplicated per repo</text>
    </svg>
  )}

  {variant === "mcp" && (
    <svg
      viewBox="0 0 880 260"
      class="block w-full h-auto"
      style='font-family: "Plus Jakarta Sans Variable", "Plus Jakarta Sans", system-ui, sans-serif;'
      role="img"
      aria-label="Dual-mode MCP architecture showing local stdio mode and team HTTP mode with Bearer RBAC and audit log"
    >
      <defs>
        <pattern id="grid-vs-mcp" width="20" height="20" patternUnits="userSpaceOnUse">
          <circle cx="1" cy="1" r="0.7" fill="#1b1b21" />
        </pattern>
      </defs>
      <rect width="880" height="260" fill="url(#grid-vs-mcp)" />

      <!-- Center divider -->
      <line x1="440" y1="22" x2="440" y2="238" stroke="#232328" stroke-width="1" stroke-dasharray="4 4" />

      <!-- Left: Local stdio -->
      <circle cx="38" cy="30" r="3" fill="#34d399" />
      <text x="48" y="34" fill="#f4f4f5" font-size="12.5" font-weight="600">Local stdio</text>
      <text x="408" y="34" text-anchor="end" fill="#8a8a93" font-size="11">memtwig mcp</text>

      <rect x="32" y="52" width="116" height="40" rx="5" fill="#121217" stroke="#2a2a32" stroke-width="1" />
      <text x="90" y="76" text-anchor="middle" fill="#e4e4e7" font-size="12" font-weight="500">Claude Code</text>

      <rect x="162" y="52" width="116" height="40" rx="5" fill="#121217" stroke="#2a2a32" stroke-width="1" />
      <text x="220" y="76" text-anchor="middle" fill="#e4e4e7" font-size="12" font-weight="500">Cursor</text>

      <rect x="292" y="52" width="116" height="40" rx="5" fill="#121217" stroke="#2a2a32" stroke-width="1" />
      <text x="350" y="76" text-anchor="middle" fill="#e4e4e7" font-size="12" font-weight="500">Codex</text>

      <path d="M 90 92 C 90 106, 180 106, 180 118" fill="none" stroke="#34d399" stroke-width="1.3" stroke-opacity="0.7" />
      <line x1="220" y1="92" x2="220" y2="118" stroke="#34d399" stroke-width="1.3" stroke-opacity="0.85" />
      <path d="M 350 92 C 350 106, 260 106, 260 118" fill="none" stroke="#34d399" stroke-width="1.3" stroke-opacity="0.7" />

      <rect x="92" y="118" width="256" height="44" rx="6" fill="#141418" stroke="#3a3a44" stroke-width="1" />
      <text x="220" y="138" text-anchor="middle" fill="#f4f4f5" font-size="12.5" font-weight="600">memtwig mcp</text>
      <text x="220" y="153" text-anchor="middle" fill="#8a8a93" font-size="10.5">6 scoped tools · zero network</text>

      <line x1="220" y1="162" x2="220" y2="184" stroke="#34d399" stroke-width="1.5" />
      <circle cx="220" cy="184" r="2.5" fill="#34d399" />

      <rect x="32" y="184" width="376" height="48" rx="6" fill="#121217" stroke="#2f2f38" stroke-width="1" />
      <text x="48" y="212" fill="#f4f4f5" font-size="12.5" font-weight="500">Local Vaults</text>
      <text x="392" y="212" text-anchor="end" fill="#34d399" font-size="11">cwd &amp; git remote isolation</text>

      <!-- Right: Team HTTP -->
      <circle cx="478" cy="30" r="3" fill="#34d399" />
      <text x="488" y="34" fill="#f4f4f5" font-size="12.5" font-weight="600">Team HTTP</text>
      <text x="848" y="34" text-anchor="end" fill="#8a8a93" font-size="11">memtwig serve</text>

      <rect x="502" y="52" width="316" height="40" rx="6" fill="#121217" stroke="#2f2f38" stroke-width="1" />
      <text x="518" y="76" fill="#f4f4f5" font-size="12" font-weight="500">Team Agents</text>
      <text x="802" y="76" text-anchor="end" fill="#8a8a93" font-size="10.5">POST /mcp · Bearer</text>

      <line x1="660" y1="92" x2="660" y2="118" stroke="#34d399" stroke-width="1.5" />
      <circle cx="660" cy="118" r="2.5" fill="#34d399" />

      <rect x="502" y="118" width="316" height="44" rx="6" fill="#141418" stroke="#3a3a44" stroke-width="1" />
      <text x="518" y="144" fill="#f4f4f5" font-size="12.5" font-weight="600">RBAC Gate</text>
      <text x="802" y="144" text-anchor="end" fill="#34d399" font-size="10.5">role + vault + path globs</text>

      <path d="M 600 162 L 562 184" fill="none" stroke="#34d399" stroke-width="1.3" stroke-opacity="0.8" />
      <path d="M 720 162 L 758 184" fill="none" stroke="#34d399" stroke-width="1.3" stroke-opacity="0.8" />

      <rect x="472" y="184" width="180" height="48" rx="6" fill="#121217" stroke="#2f2f38" stroke-width="1" />
      <text x="488" y="205" fill="#f4f4f5" font-size="12" font-weight="500">Audit Log</text>
      <text x="488" y="221" fill="#8a8a93" font-size="10.5">append-only audit.jsonl</text>

      <rect x="668" y="184" width="180" height="48" rx="6" fill="#121217" stroke="#2f2f38" stroke-width="1" />
      <text x="684" y="205" fill="#f4f4f5" font-size="12" font-weight="500">Proposals</text>
      <text x="684" y="221" fill="#8a8a93" font-size="10.5">reviewable diff queue</text>
    </svg>
  )}
</div>
