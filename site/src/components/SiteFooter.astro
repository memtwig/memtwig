---
const repoUrl = "https://github.com/memtwig/memtwig";
const releasesUrl = "https://github.com/memtwig/memtwig/releases";
const docsUrl = "https://github.com/memtwig/memtwig/tree/main/docs";
---

<footer class="border-t border-white/[0.08] bg-[#111112] pt-20 pb-12">
  <div class="mx-auto max-w-6xl px-5 sm:px-8">
    <div class="grid gap-12 lg:grid-cols-12">
      <div class="lg:col-span-5">
        <a href="/" class="inline-flex items-center gap-2.5 text-base font-semibold tracking-tight text-white">
          <img src="/favicon.svg" alt="" width="24" height="24" class="rounded-lg" />
          <span>memtwig</span>
        </a>
        <p class="mt-6 max-w-md text-2xl font-normal leading-[1.28] tracking-[-0.025em] text-zinc-100 sm:text-[1.7rem]">
          Git-native Markdown memory on your own machine. Isolated per client, shared across every AI agent you run.
        </p>
        <div class="mt-6">
          <a
            href="/#install"
            class="inline-flex items-center gap-1.5 text-sm font-medium text-[#58cc7d] transition-colors hover:text-[#7ee09e]"
          >
            Install memtwig →
          </a>
        </div>
      </div>

      <div class="grid grid-cols-2 gap-8 text-sm sm:grid-cols-3 lg:col-span-7">
        <div>
          <h3 class="text-sm font-medium text-white">Product</h3>
          <ul class="mt-4 space-y-2.5 text-zinc-400">
            <li><a href="/#studio" class="transition-colors hover:text-white">Studio UI</a></li>
            <li><a href="/#features" class="transition-colors hover:text-white">How it works</a></li>
            <li><a href="/cloud" class="transition-colors hover:text-white">Memtwig Cloud</a></li>
            <li><a href="/#install" class="transition-colors hover:text-white">Quickstart</a></li>
            <li><a href={releasesUrl} target="_blank" rel="noreferrer" class="transition-colors hover:text-white">Releases</a></li>
          </ul>
        </div>

        <div>
          <h3 class="text-sm font-medium text-white">Integrations</h3>
          <ul class="mt-4 space-y-2.5 text-zinc-400">
            <li><a href="/integrations" class="transition-colors hover:text-white">All integrations</a></li>
            <li><a href="/integrations/claude-code" class="transition-colors hover:text-white">Claude Code</a></li>
            <li><a href="/integrations/cursor" class="transition-colors hover:text-white">Cursor</a></li>
            <li><a href="/integrations/codex" class="transition-colors hover:text-white">OpenAI Codex</a></li>
            <li><a href="/integrations/hermes" class="transition-colors hover:text-white">Hermes Agent</a></li>
            <li><a href="/integrations/grok-bot" class="transition-colors hover:text-white">Grok Bot</a></li>
            <li><a href="/integrations/openbot" class="transition-colors hover:text-white">OpenBot</a></li>
            <li><a href="/integrations/t3-code" class="transition-colors hover:text-white">T3 Code</a></li>
            <li><a href="/integrations/antigravity" class="transition-colors hover:text-white">Antigravity</a></li>
          </ul>
        </div>

        <div>
          <h3 class="text-sm font-medium text-white">Compare &amp; Docs</h3>
          <ul class="mt-4 space-y-2.5 text-zinc-400">
            <li><a href="/vs/mem0" class="transition-colors hover:text-white">vs Mem0</a></li>
            <li><a href="/vs/claude-md" class="transition-colors hover:text-white">vs CLAUDE.md</a></li>
            <li><a href="/mcp-memory" class="transition-colors hover:text-white">MCP Memory Server</a></li>
            <li><a href={docsUrl} target="_blank" rel="noreferrer" class="transition-colors hover:text-white">Documentation</a></li>
            <li><a href={repoUrl} target="_blank" rel="noreferrer" class="transition-colors hover:text-white">GitHub</a></li>
            <li><a href="/llms.txt" class="transition-colors hover:text-white">llms.txt</a></li>
          </ul>
        </div>
      </div>
    </div>

    <div class="mt-16 flex flex-col items-start justify-between gap-4 border-t border-white/[0.07] pt-8 text-xs text-muted-foreground sm:flex-row sm:items-center">
      <span>© 2026 Vittorio Compagno · Apache 2.0 · <a href="/privacy" class="transition-colors hover:text-white">Privacy</a></span>
      <span class="inline-flex items-center gap-2 text-zinc-300">
        <span class="size-2 rounded-full bg-[#58cc7d]" aria-hidden="true"></span>
        <span>Single binary for macOS, Linux, and Windows</span>
      </span>
    </div>
  </div>
</footer>
