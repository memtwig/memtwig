---
import ArticleLayout from "@/layouts/ArticleLayout.astro";
import { CloudDeck } from "@/components/CloudDeck";
import { WaitlistForm } from "@/components/WaitlistForm";
import { buttonVariants } from "@/components/ui/button";
import { cn } from "@/lib/utils";

const faqs = [
  {
    q: "Can I leave Memtwig Cloud and run locally anytime?",
    a: "Yes. Every note and decision stays as plain Markdown inside your Git repository, so you can drop back to the free Go binary in seconds.",
  },
  {
    q: "Does Cloud Curator edit my notes without approval?",
    a: "Never. Cloud Curator only opens reviewable diffs or pull requests for you or your team to approve or reject.",
  },
  {
    q: "When does early access open?",
    a: "We are onboarding waitlist teams in batches starting with multi-client freelancers and teams running hosted MCP agents.",
  },
];
---

<ArticleLayout
  title="Managed Cloud Curator and Hosted MCP for teams"
  description="Managed Memtwig Cloud: scheduled Cloud Curator, hosted HTTPS MCP with per-agent RBAC, managed 1024-dim embeddings, and two-way GitHub/GitLab sync."
  path="/cloud"
  faqs={faqs}
>
  <header class="max-w-3xl">
    <h1 class="text-balance text-5xl font-medium leading-[1.04] tracking-[-0.04em] text-white sm:text-6xl">
      Memtwig Cloud.
    </h1>
    <p class="mt-4 text-base leading-relaxed text-zinc-400 sm:text-xl">
      Managed Cloud Curator, hosted HTTPS MCP, and Git sync for teams and always-on bots.
    </p>
    <div class="mt-8 flex flex-wrap items-center gap-3">
      <a href="#waitlist" class={cn(buttonVariants({ variant: "default", size: "lg" }))}>
        Join the waitlist
      </a>
      <a href="/#install" class={cn(buttonVariants({ variant: "outline", size: "lg" }))}>
        Self-host free
      </a>
    </div>
  </header>

  <section class="mt-14">
    <CloudDeck client:load showHeader={false} />
  </section>

  <section id="pricing" class="mt-24 scroll-mt-24">
    <h2 class="text-3xl font-medium tracking-[-0.03em] text-white sm:text-4xl">Pricing</h2>
    <div class="mt-8 grid gap-5 md:grid-cols-3">
      <!-- Open Source -->
      <div class="flex flex-col justify-between rounded-[26px] border border-white/[0.08] bg-[#1c1c1f] p-7 sm:p-8">
        <div>
          <h3 class="text-xl font-medium text-white">Open Source</h3>
          <div class="mt-4 text-4xl font-normal tracking-[-0.03em] text-white tabular-nums">
            $0 <span class="text-sm font-normal text-zinc-400">forever</span>
          </div>
          <ul class="mt-6 space-y-3 text-sm text-zinc-400">
            <li class="flex items-start gap-2.5">
              <span class="mt-2 size-1.5 shrink-0 rounded-full bg-zinc-500"></span>
              <span>Local CLI, Studio UI &amp; TUI</span>
            </li>
            <li class="flex items-start gap-2.5">
              <span class="mt-2 size-1.5 shrink-0 rounded-full bg-zinc-500"></span>
              <span>SQLite FTS5 + BYO keys</span>
            </li>
            <li class="flex items-start gap-2.5">
              <span class="mt-2 size-1.5 shrink-0 rounded-full bg-zinc-500"></span>
              <span>Self-host memtwig serve</span>
            </li>
          </ul>
        </div>
        <div class="mt-8">
          <a href="/#install" class={cn(buttonVariants({ variant: "outline", size: "default" }), "w-full")}>
            Install free
          </a>
        </div>
      </div>

      <!-- Cloud Pro (Vivid Mint Solid) -->
      <div class="flex flex-col justify-between rounded-[26px] bg-[#58cc7d] p-7 text-[#111312] sm:p-8">
        <div>
          <div class="flex items-center justify-between gap-2">
            <h3 class="text-xl font-medium text-[#111312]">Cloud Pro</h3>
            <span class="rounded-full bg-black/10 px-2.5 py-0.5 text-xs font-medium text-[#111312]/80">
              Early access
            </span>
          </div>
          <div class="mt-4 text-4xl font-normal tracking-[-0.03em] text-[#111312] tabular-nums">
            $19 <span class="text-sm font-normal text-[#111312]/75">/ mo</span>
          </div>
          <ul class="mt-6 space-y-3 text-sm text-[#111312]/85">
            <li class="flex items-start gap-2.5">
              <span class="mt-2 size-1.5 shrink-0 rounded-full bg-[#111312]"></span>
              <span>Cloud Curator (nightly LLM hygiene)</span>
            </li>
            <li class="flex items-start gap-2.5">
              <span class="mt-2 size-1.5 shrink-0 rounded-full bg-[#111312]"></span>
              <span>Hosted HTTPS /mcp endpoint</span>
            </li>
            <li class="flex items-start gap-2.5">
              <span class="mt-2 size-1.5 shrink-0 rounded-full bg-[#111312]"></span>
              <span>Managed 1024-dim embeddings</span>
            </li>
            <li class="flex items-start gap-2.5">
              <span class="mt-2 size-1.5 shrink-0 rounded-full bg-[#111312]"></span>
              <span>GitHub / GitLab sync · up to 5 vaults</span>
            </li>
          </ul>
        </div>
        <div class="mt-8">
          <a href="#waitlist" data-plan="pro" class={cn(buttonVariants({ variant: "dark", size: "default" }), "w-full")}>
            Join waitlist
          </a>
        </div>
      </div>

      <!-- Cloud Team -->
      <div class="flex flex-col justify-between rounded-[26px] border border-white/[0.08] bg-[#1c1c1f] p-7 sm:p-8">
        <div>
          <h3 class="text-xl font-medium text-white">Cloud Team</h3>
          <div class="mt-4 text-4xl font-normal tracking-[-0.03em] text-white tabular-nums">
            $49 <span class="text-sm font-normal text-zinc-400">/ mo</span>
          </div>
          <ul class="mt-6 space-y-3 text-sm text-zinc-400">
            <li class="flex items-start gap-2.5">
              <span class="mt-2 size-1.5 shrink-0 rounded-full bg-[#58cc7d]"></span>
              <span>Unlimited client vaults</span>
            </li>
            <li class="flex items-start gap-2.5">
              <span class="mt-2 size-1.5 shrink-0 rounded-full bg-[#58cc7d]"></span>
              <span>Per-agent &amp; teammate RBAC tokens</span>
            </li>
            <li class="flex items-start gap-2.5">
              <span class="mt-2 size-1.5 shrink-0 rounded-full bg-[#58cc7d]"></span>
              <span>PR approval flow &amp; audit retention</span>
            </li>
            <li class="flex items-start gap-2.5">
              <span class="mt-2 size-1.5 shrink-0 rounded-full bg-[#58cc7d]"></span>
              <span>Priority onboarding</span>
            </li>
          </ul>
        </div>
        <div class="mt-8">
          <a href="#waitlist" data-plan="team" class={cn(buttonVariants({ variant: "outline", size: "default" }), "w-full")}>
            Join waitlist
          </a>
        </div>
      </div>
    </div>
    <p class="mt-5 text-xs text-zinc-500 sm:text-sm">
      Planned early-access pricing — join the waitlist to get invited first.
    </p>
  </section>

  <section id="waitlist" class="mt-20 scroll-mt-24">
    <div class="rounded-[28px] border border-white/[0.08] bg-[#1c1c1f] p-7 sm:p-10">
      <h2 class="text-2xl font-medium tracking-[-0.02em] text-white sm:text-3xl">Request early access</h2>
      <div class="mt-6">
        <WaitlistForm client:load />
      </div>
    </div>
  </section>
</ArticleLayout>
