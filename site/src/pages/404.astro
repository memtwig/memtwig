---
import ArticleLayout from "@/layouts/ArticleLayout.astro";
import { buttonVariants } from "@/components/ui/button";
import { cn } from "@/lib/utils";
---

<ArticleLayout
  title="Page not found"
  description="This page does not exist. Head back to memtwig, Git-native Markdown memory for AI agents."
  path="/404"
  schemaType="WebPage"
  noindex
  updated={false}
>
  <header class="max-w-2xl py-10">
    <p class="font-mono text-sm text-[#58cc7d]">404</p>
    <h1 class="mt-4 text-balance text-5xl font-medium leading-[1.04] tracking-[-0.04em] text-white sm:text-6xl">
      This twig doesn't grow here.
    </h1>
    <p class="mt-4 text-base leading-relaxed text-zinc-400 sm:text-xl">
      The page you asked for does not exist or has moved.
    </p>
    <div class="mt-8 flex flex-wrap gap-3">
      <a href="/" class={cn(buttonVariants({ size: "lg" }))}>Back to home</a>
      <a href="/integrations" class={cn(buttonVariants({ variant: "outline", size: "lg" }))}>Integrations</a>
      <a href="/#install" class={cn(buttonVariants({ variant: "outline", size: "lg" }))}>Install</a>
    </div>
  </header>
</ArticleLayout>
