---
import "@/styles/global.css";
import { buttonVariants } from "@/components/ui/button";
import { cn } from "@/lib/utils";
import SiteHeader from "@/components/SiteHeader.astro";
import SiteFooter from "@/components/SiteFooter.astro";
import FeatureBento from "@/components/FeatureBento.astro";
import TechDetails from "@/components/TechDetails.astro";
import { HeroTwigBadge } from "@/components/HeroMark";
import { AgentPromptBox } from "@/components/AgentPromptBox";
import { QuickstartTabs } from "@/components/QuickstartTabs";
import { DetailsDialog } from "@/components/DetailsDialog";
import { StudioDialog } from "@/components/StudioDialog";
import { CloudDialog } from "@/components/CloudDialog";

const siteUrl = "https://memtwig.com";
const repoUrl = "https://github.com/memtwig/memtwig";
const releasesUrl = "https://github.com/memtwig/memtwig/releases";
const docsUrl = "https://github.com/memtwig/memtwig/tree/main/docs";

const title = "Memtwig: Git-native memory for AI agents";
const description =
  "Plain Markdown vaults, isolated per client, in one local Go binary with embedded Studio UI for Claude Code, Codex, and Cursor.";

const keytwigUrl = "https://github.com/keytwig/keytwig";

const steps = [
  {
    n: "01",
    img: "/illustrations/step-1-capture.webp",
    title: "Write once in plain Markdown",
    text: "Your notes stay readable .md files inside Git, never trapped in a proprietary database.",
  },
  {
    n: "02",
    img: "/illustrations/step-2-recall.webp",
    title: "Every agent recalls the right context",
    text: "Local hybrid search surfaces only the relevant notes for each task.",
  },
  {
    n: "03",
    img: "/illustrations/step-3-approve.webp",
    title: "You approve every team change",
    text: "Agents propose edits as reviewable diffs you accept or reject before they merge.",
  },
];

const matrix = [
  { capability: "Plain Git files", memtwig: "check", cloud: "dash", staticMd: "check" },
  { capability: "Per-client isolation", memtwig: "check", cloud: "Manual", staticMd: "dash" },
  { capability: "Works offline", memtwig: "check", cloud: "dash", staticMd: "check" },
  { capability: "Diff approval", memtwig: "check", cloud: "dash", staticMd: "dash" },
  { capability: "Multi-agent", memtwig: "check", cloud: "SDK", staticMd: "dash" },
] as const;

const faqs = [
  {
    q: "How does per-client isolation work?",
    a: "Each folder maps to a vault by path or Git remote, so an agent in Client A's repo never sees Client B's notes.",
  },
  {
    q: "Do I need a cloud database or API key?",
    a: "No. Local search and the embedded Studio UI run out of the box offline; optional embeddings and LLM curation can be added anytime.",
  },
  {
    q: "Can agents overwrite my team notes?",
    a: "Protected vaults queue reviewable diffs that you approve or reject from the CLI, TUI, or Studio UI.",
  },
  {
    q: "Which coding agents are supported?",
    a: "Claude Code, Cursor, Codex, Antigravity, Hermes, Grok Bot, OpenBot, T3 Code, and any client supporting standard MCP.",
  },
];

const jsonLd = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebSite",
      "@id": `${siteUrl}/#website`,
      url: `${siteUrl}/`,
      name: "memtwig",
      description,
      inLanguage: "en",
    },
    {
      "@type": "SoftwareApplication",
      "@id": `${siteUrl}/#software`,
      name: "memtwig",
      url: `${siteUrl}/`,
      applicationCategory: "DeveloperApplication",
      operatingSystem: "Linux, macOS, Windows",
      softwareVersion: "1.6.0",
      datePublished: "2026-11-24",
      dateModified: "2026-11-24",
      license: "https://www.apache.org/licenses/LICENSE-2.0",
      codeRepository: repoUrl,
      downloadUrl: `${releasesUrl}/tag/v1.6.0`,
      description,
      offers: {
        "@type": "Offer",
        price: "0",
        priceCurrency: "USD",
      },
      author: {
        "@type": "Person",
        "@id": "https://vittoriocompagno.com/#person",
        name: "Vittorio Compagno",
        url: "https://vittoriocompagno.com",
        sameAs: [
          "https://github.com/vittoriocompagno",
          "https://x.com/toriodev",
          "https://www.linkedin.com/in/vittorio-compagno",
        ],
      },
    },
    {
      "@type": "FAQPage",
      "@id": `${siteUrl}/#faq`,
      mainEntity: faqs.map((item) => ({
        "@type": "Question",
        name: item.q,
        acceptedAnswer: {
          "@type": "Answer",
          text: item.a,
        },
      })),
    },
  ],
};
---

<!doctype html>
<html lang="en" class="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={`${siteUrl}/`} />
    <link rel="alternate" type="text/markdown" href={`${siteUrl}/llms.txt`} title="LLMs summary" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="memtwig" />
    <meta property="og:url" content={`${siteUrl}/`} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={`${siteUrl}/og-image.png?v=2`} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:creator" content="@toriodev" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={`${siteUrl}/og-image.png?v=2`} />

    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  </head>
  <body class="relative min-h-screen bg-background text-foreground">
    <div class="pointer-events-none absolute inset-x-0 top-0 h-[640px] overflow-hidden" aria-hidden="true">
      <div class="hero-beam absolute -top-40 left-1/2 h-[560px] w-[760px] -translate-x-1/2 rounded-full bg-[radial-gradient(circle_at_center,rgba(88,204,125,0.16)_0%,rgba(107,181,255,0.08)_45%,transparent_72%)] blur-3xl" />
    </div>

    <SiteHeader currentPath="/" />

    <main>
      <!-- Hero -->
      <section class="mx-auto max-w-6xl px-5 pt-20 pb-24 sm:px-8 sm:pt-28 sm:pb-32">
        <div class="mx-auto max-w-5xl text-center">
          <h1 class="text-5xl leading-[1.02] font-medium tracking-[-0.045em] text-white sm:text-7xl xl:text-[5.5rem]">
            <span class="lg:whitespace-nowrap">Git-native <HeroTwigBadge client:load /> memory</span><br />for every AI agent.
          </h1>
          <p class="mx-auto mt-7 max-w-2xl text-lg leading-relaxed text-zinc-400 sm:text-xl">
            Claude Code, Codex, Cursor and every agent you run share one memory: plain Markdown in your own Git, kept apart per client.
          </p>
          <div class="mt-10 flex flex-wrap items-center justify-center gap-3">
            <a href="#install" class={cn(buttonVariants({ variant: "default", size: "lg" }))}>Install v1.6.0</a>
            <a href="/cloud" class={cn(buttonVariants({ variant: "outline", size: "lg" }))}>Memtwig Cloud</a>
          </div>
        </div>

        <div class="relative mx-auto mt-10 max-w-3xl sm:mt-12">
          <div class="render-glow pointer-events-none absolute inset-x-[18%] top-[22%] bottom-[18%] rounded-full bg-[radial-gradient(ellipse_at_center,rgba(88,204,125,0.16),rgba(107,181,255,0.07)_45%,transparent_70%)] blur-3xl" aria-hidden="true"></div>
          <img
            src="/illustrations/hero-memory.webp"
            alt=""
            width="1400"
            height="788"
            fetchpriority="high"
            decoding="async"
            class="render render-wide render-float relative mx-auto block h-auto w-full"
          />
        </div>

        <div id="install" class="mx-auto mt-12 max-w-3xl scroll-mt-24 sm:mt-16">
          <h2 class="text-center text-3xl font-medium tracking-[-0.03em] text-white sm:text-4xl">Install in one line</h2>
          <div class="mt-8">
            <QuickstartTabs client:load />
          </div>
          <a
            href={releasesUrl}
            target="_blank"
            rel="noreferrer"
            class="mt-4 inline-flex text-sm font-medium text-zinc-400 transition-colors hover:text-white"
          >
            Prebuilt binaries for Linux, macOS and Windows ↗
          </a>
        </div>
      </section>

      <!-- How it works -->
      <section id="features" class="mx-auto max-w-6xl scroll-mt-24 px-5 py-24 sm:px-8 sm:py-32">
        <h2 class="text-center text-4xl font-medium tracking-[-0.04em] text-white sm:text-6xl">How it works</h2>
        <ol class="mt-14 grid list-none gap-4 p-0 md:grid-cols-3" role="list">
          {
            steps.map((st) => (
              <li class="surface flex min-w-0 flex-col overflow-hidden rounded-[32px]">
                <div class="relative aspect-[3/2]">
                  <img src={st.img} alt="" width="1000" height="667" loading="lazy" decoding="async" class="render absolute inset-0 size-full object-cover" />
                </div>
                <div class="-mt-2 px-8 pb-9 sm:px-9">
                  <span class="inline-flex rounded-full border border-[#58cc7d]/25 bg-[#58cc7d]/10 px-2.5 py-0.5 text-xs font-medium text-[#8be3a6] tabular-nums">{st.n}</span>
                  <h3 class="mt-4 text-2xl leading-tight font-medium tracking-[-0.025em] text-white">{st.title}</h3>
                  <p class="mt-3 text-base leading-relaxed text-zinc-400">{st.text}</p>
                </div>
              </li>
            ))
          }
        </ol>
        <div id="studio" class="mt-10 flex scroll-mt-24 justify-center">
          <StudioDialog client:load />
        </div>
      </section>

      <!-- Benefits -->
      <section id="benefits" class="mx-auto max-w-6xl scroll-mt-24 px-5 py-24 sm:px-8 sm:py-32">
        <h2 class="mx-auto max-w-3xl text-center text-4xl font-medium tracking-[-0.04em] text-balance text-white sm:text-6xl">
          Built for agents that actually remember.
        </h2>
        <div class="mt-14">
          <FeatureBento />
        </div>
        <div class="mt-10 flex justify-center">
          <DetailsDialog client:load label="Technical details" title="Technical details, v1.6.0" size="lg" variant="ghost">
            <TechDetails />
          </DetailsDialog>
        </div>
      </section>

      <!-- Cloud -->
      <section id="cloud" class="mx-auto max-w-6xl scroll-mt-24 px-5 py-24 sm:px-8 sm:py-32">
        <div class="rounded-[40px] border border-white/[0.07] bg-[radial-gradient(ellipse_at_top,rgba(107,181,255,0.09),transparent_60%),#161618] px-6 py-16 text-center shadow-[inset_0_1px_0_rgba(255,255,255,0.06)] sm:px-12 sm:py-24">
          <h2 class="text-4xl font-medium tracking-[-0.04em] text-white sm:text-6xl">Memtwig Cloud</h2>
          <p class="mx-auto mt-5 max-w-xl text-lg text-zinc-400 sm:text-xl">Managed curator, hosted MCP and synced embeddings for teams. Still your Git.</p>
          <div class="mt-10 flex flex-wrap items-center justify-center gap-3">
            <a href="/cloud" class={cn(buttonVariants({ variant: "default", size: "lg" }))}>Join the waitlist</a>
            <CloudDialog client:load />
          </div>
        </div>
      </section>

      <!-- Agent prompts -->
      <section id="install-agent" class="mx-auto max-w-4xl scroll-mt-24 px-5 py-24 sm:px-8 sm:py-32">
        <h2 class="text-center text-4xl font-medium tracking-[-0.04em] text-white sm:text-6xl">Hand the rest to your agent</h2>
        <div class="mt-14">
          <AgentPromptBox client:visible />
        </div>
      </section>

      <!-- Borderless Comparison Strip -->
      <section id="comparison" class="mx-auto max-w-6xl scroll-mt-24 px-5 py-20 sm:px-8 sm:py-28">
        <div class="mx-auto max-w-2xl text-center">
          <h2 class="text-4xl font-medium tracking-[-0.04em] text-white sm:text-6xl">
            How it compares
          </h2>
          <p class="mt-3 text-base text-zinc-400">
            Keep plain Git ownership without SaaS lock-in or bloated context files.
          </p>
        </div>

        <div class="mt-10 overflow-x-auto">
          <table class="w-full min-w-[520px] border-collapse text-left text-sm sm:text-base">
            <thead>
              <tr class="border-b border-white/[0.08]">
                <th class="py-4 pr-6 font-medium text-zinc-400"></th>
                <th class="px-6 py-4 text-center font-medium text-white">memtwig</th>
                <th class="px-6 py-4 text-center font-medium text-zinc-400">Cloud Memory APIs</th>
                <th class="px-6 py-4 pl-6 text-center font-medium text-zinc-400">Static .md files</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-white/[0.08]">
              {matrix.map((row) => (
                <tr>
                  <td class="py-4 pr-6 font-medium text-white">{row.capability}</td>
                  <td class="px-6 py-4 text-center">
                    <span class="font-medium text-[#58cc7d]" aria-label="Yes">✓</span>
                  </td>
                  <td class="px-6 py-4 text-center text-zinc-400">
                    {row.cloud === "dash" ? (
                      <span aria-label="No">—</span>
                    ) : (
                      <span class="rounded-full bg-white/[0.06] px-2.5 py-0.5 text-xs text-zinc-300">{row.cloud}</span>
                    )}
                  </td>
                  <td class="px-6 py-4 pl-6 text-center text-zinc-400">
                    {row.staticMd === "check" ? (
                      <span class="font-medium text-zinc-200" aria-label="Yes">✓</span>
                    ) : (
                      <span aria-label="No">—</span>
                    )}
                  </td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>

        <div class="mt-6 flex flex-wrap justify-center gap-6 text-sm font-medium text-zinc-400">
          <a href="/vs/mem0" class="transition-colors hover:text-white">Compare vs Mem0 →</a>
          <a href="/vs/claude-md" class="transition-colors hover:text-white">Compare vs CLAUDE.md →</a>
          <a href="/mcp-memory" class="transition-colors hover:text-white">Explore MCP Memory →</a>
        </div>
      </section>

      <!-- Split 2-Column Questions FAQ -->
      <section id="faq" class="mx-auto max-w-6xl scroll-mt-24 px-5 py-20 pb-28 sm:px-8 sm:py-24 sm:pb-36">
        <div class="grid gap-10 border-t border-white/[0.08] pt-16 lg:grid-cols-12">
          <div class="lg:col-span-4">
            <h2 class="text-4xl font-medium tracking-[-0.035em] text-white sm:text-5xl">Questions</h2>
            <p class="mt-3 text-base leading-relaxed text-zinc-400">
              Short answers about vaults, privacy, and supported agents.
            </p>
            <a
              href={docsUrl}
              target="_blank"
              rel="noreferrer"
              class="mt-5 inline-flex items-center gap-1.5 text-sm font-medium text-white transition-colors hover:text-[#58cc7d]"
            >
              Read the docs →
            </a>
          </div>

          <div class="divide-y divide-white/[0.08] lg:col-span-8">
            {faqs.map((item) => (
              <details class="group py-5 first:pt-0">
                <summary class="flex cursor-pointer list-none items-center justify-between gap-4 text-base font-medium text-white sm:text-lg [&::-webkit-details-marker]:hidden">
                  <span>{item.q}</span>
                  <span class="shrink-0 text-xl font-normal text-zinc-400 transition-transform duration-150 group-open:rotate-45">+</span>
                </summary>
                <p class="mt-3 max-w-2xl text-sm leading-relaxed text-zinc-400 sm:text-base">{item.a}</p>
              </details>
            ))}
          </div>
        </div>
      </section>
    
      <!-- Twig family -->
      <section id="family" class="mx-auto max-w-6xl scroll-mt-24 px-5 pt-8 pb-28 sm:px-8 sm:pb-36">
        <h2 class="text-center text-4xl font-medium tracking-[-0.04em] text-white sm:text-5xl">The Twig family</h2>
        <div class="mx-auto mt-12 grid max-w-4xl gap-4 sm:grid-cols-2">
          <div class="surface flex items-center gap-5 rounded-[28px] !border-[#58cc7d]/30 p-6 sm:p-8">
            <img src="/favicon.svg" alt="" width="48" height="48" class="size-12 shrink-0" />
            <div class="min-w-0">
              <p class="text-xl font-medium text-white">memtwig</p>
              <p class="mt-0.5 text-sm text-zinc-400">Memory for your agents · v1.6.0</p>
            </div>
          </div>
          <a href={keytwigUrl} target="_blank" rel="noreferrer" class="surface flex items-center gap-5 rounded-[28px] p-6 hover:!border-[#ebb85e]/40 sm:p-8">
            <svg viewBox="0 0 32 32" class="size-12 shrink-0" fill="none" aria-hidden="true">
              <rect width="32" height="32" rx="8" fill="#ebb85e"></rect>
              <circle cx="16" cy="10.6" r="4.2" stroke="#141415" stroke-width="2.6"></circle>
              <path d="M16 14.8V25" stroke="#141415" stroke-width="2.6" stroke-linecap="round"></path>
              <path d="M16 20.6H20.6" stroke="#141415" stroke-width="2.6" stroke-linecap="round"></path>
              <path d="M16 24.4H19.4" stroke="#141415" stroke-width="2.6" stroke-linecap="round"></path>
              <circle cx="16" cy="10.6" r="1.35" fill="#141415"></circle>
            </svg>
            <div class="min-w-0">
              <p class="text-xl font-medium text-white">keytwig</p>
              <p class="mt-0.5 text-sm text-zinc-400">Secrets for your agents ↗</p>
            </div>
          </a>
        </div>
      </section>
    </main>

    <SiteFooter />
  </body>
</html>
