---
import "@/styles/global.css";
import { buttonVariants } from "@/components/ui/button";
import { cn } from "@/lib/utils";
import { MobileNav } from "@/components/MobileNav";
import { StudioShowcase } from "@/components/StudioShowcase";
import FeatureGrid from "@/components/FeatureGrid.astro";
import { ScopeDemo } from "@/components/ScopeDemo";
import { QuickstartTabs } from "@/components/QuickstartTabs";

const siteUrl = "https://memtwig.com";
const repoUrl = "https://github.com/memtwig/memtwig";
const releasesUrl = "https://github.com/memtwig/memtwig/releases";
const docsUrl = "https://github.com/memtwig/memtwig/tree/main/docs";

const title = "memtwig — Git-native memory for AI agents";
const description =
  "Plain Markdown vaults, isolated per client, in one local Go binary with embedded Studio UI for Claude Code, Codex, and Cursor.";

const matrix = [
  { capability: "Plain Git files", memtwig: "check", cloud: "dash", staticMd: "check" },
  { capability: "Per-client isolation", memtwig: "check", cloud: "Manual", staticMd: "dash" },
  { capability: "Works offline", memtwig: "check", cloud: "dash", staticMd: "check" },
  { capability: "Diff approval", memtwig: "check", cloud: "dash", staticMd: "dash" },
  { capability: "Multi-agent", memtwig: "check", cloud: "SDK", staticMd: "dash" },
] as const;

const faqs = [
  {
    q: "How does per-client isolation work?",
    a: "Each folder maps to a vault by path or Git remote, so an agent in Client A's repo never sees Client B's notes.",
  },
  {
    q: "Do I need a cloud database or API key?",
    a: "No. Local search and the embedded Studio UI run out of the box offline; optional embeddings and LLM curation can be added anytime.",
  },
  {
    q: "Can agents overwrite my team notes?",
    a: "Protected vaults queue reviewable diffs that you approve or reject from the CLI, TUI, or Studio UI.",
  },
  {
    q: "Which coding agents are supported?",
    a: "Claude Code, Cursor, Codex, Antigravity, Hermes, and any client supporting standard MCP.",
  },
];

const jsonLd = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebSite",
      "@id": `${siteUrl}/#website`,
      url: `${siteUrl}/`,
      name: "memtwig",
      description,
      inLanguage: "en",
    },
    {
      "@type": "SoftwareApplication",
      "@id": `${siteUrl}/#software`,
      name: "memtwig",
      url: `${siteUrl}/`,
      applicationCategory: "DeveloperApplication",
      operatingSystem: "Linux, macOS, Windows",
      softwareVersion: "1.4.2",
      datePublished: "2026-11-23",
      dateModified: "2026-11-23",
      license: "https://www.apache.org/licenses/LICENSE-2.0",
      codeRepository: repoUrl,
      downloadUrl: `${releasesUrl}/tag/v1.4.2`,
      description,
      offers: {
        "@type": "Offer",
        price: "0",
        priceCurrency: "USD",
      },
      author: {
        "@type": "Person",
        name: "Vittorio Compagno",
        url: "https://vittoriocompagno.com",
        sameAs: [
          "https://github.com/vittoriocompagno",
          "https://x.com/itstorio_",
          "https://www.linkedin.com/in/vittorio-compagno",
        ],
      },
    },
    {
      "@type": "FAQPage",
      "@id": `${siteUrl}/#faq`,
      mainEntity: faqs.map((item) => ({
        "@type": "Question",
        name: item.q,
        acceptedAnswer: {
          "@type": "Answer",
          text: item.a,
        },
      })),
    },
  ],
};
---

<!doctype html>
<html lang="en" class="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={`${siteUrl}/`} />
    <link rel="alternate" type="text/markdown" href={`${siteUrl}/llms.txt`} title="LLMs summary" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="memtwig" />
    <meta property="og:url" content={`${siteUrl}/`} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={`${siteUrl}/og-image.png`} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:creator" content="@itstorio_" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={`${siteUrl}/og-image.png`} />

    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  </head>
  <body class="min-h-screen bg-background text-foreground">
    <header class="sticky top-0 z-40 border-b border-border bg-background/85 backdrop-blur-md">
      <div class="mx-auto flex h-14 max-w-6xl items-center justify-between px-5 sm:px-8">
        <a href="#" class="flex items-center gap-2.5 text-sm font-semibold tracking-tight text-foreground">
          <img src="/favicon.svg" alt="" width="24" height="24" class="rounded-sm" />
          <span>memtwig</span>
        </a>

        <nav class="hidden items-center gap-1 md:flex">
          <a href="#studio" class="rounded-md px-3 py-1.5 text-sm font-medium text-muted-foreground transition-colors hover:bg-accent hover:text-foreground">Studio</a>
          <a href="#features" class="rounded-md px-3 py-1.5 text-sm font-medium text-muted-foreground transition-colors hover:bg-accent hover:text-foreground">How it works</a>
          <a href="/integrations" class="rounded-md px-3 py-1.5 text-sm font-medium text-muted-foreground transition-colors hover:bg-accent hover:text-foreground">Integrations</a>
          <a href="/cloud" class="rounded-md px-3 py-1.5 text-sm font-medium text-muted-foreground transition-colors hover:bg-accent hover:text-foreground">Cloud</a>
          <a href="#install" class="rounded-md px-3 py-1.5 text-sm font-medium text-muted-foreground transition-colors hover:bg-accent hover:text-foreground">Install</a>
          <a href={docsUrl} target="_blank" rel="noreferrer" class="rounded-md px-3 py-1.5 text-sm font-medium text-muted-foreground transition-colors hover:bg-accent hover:text-foreground">Docs</a>
        </nav>

        <div class="hidden items-center gap-2 md:flex">
          <a href={repoUrl} target="_blank" rel="noreferrer" class={cn(buttonVariants({ variant: "ghost", size: "sm" }))}>
            GitHub
          </a>
          <a href="#install" class={cn(buttonVariants({ variant: "default", size: "sm" }))}>
            Install
          </a>
        </div>

        <div class="md:hidden">
          <MobileNav client:media="(max-width: 767px)" />
        </div>
      </div>
    </header>

    <main>
      <section class="mx-auto max-w-6xl px-5 pt-16 pb-16 sm:px-8 sm:pt-24 sm:pb-20">
        <div class="mx-auto max-w-3xl text-center">
          <h1 class="text-balance text-5xl font-normal tracking-tight text-foreground sm:text-6xl xl:text-7xl leading-[1.05]">
            Git-native memory for AI agents.
          </h1>
          <p class="mx-auto mt-5 max-w-xl text-base text-muted-foreground sm:text-lg leading-relaxed">
            Plain Markdown vaults, isolated per client, in one local binary.
          </p>
          <div class="mt-8 flex flex-wrap items-center justify-center gap-3">
            <a href="#install" class={cn(buttonVariants({ size: "lg" }))}>Install v1.4.2</a>
            <a
              href={repoUrl}
              target="_blank"
              rel="noreferrer"
              class={cn(buttonVariants({ variant: "outline", size: "lg" }))}
            >
              View on GitHub
            </a>
          </div>
        </div>

        <div id="studio" class="mt-14 scroll-mt-20">
          <StudioShowcase client:load />
        </div>
      </section>

      <section id="features" class="mx-auto max-w-6xl scroll-mt-20 px-5 py-14 sm:px-8 sm:py-20">
        <h2 class="text-3xl font-medium tracking-tight text-foreground lg:text-4xl">
          How it works
        </h2>
        <div class="mt-8">
          <FeatureGrid />
        </div>
      </section>

      <section id="isolation" class="mx-auto max-w-6xl scroll-mt-20 px-5 py-14 sm:px-8 sm:py-20">
        <h2 class="text-3xl font-medium tracking-tight text-foreground lg:text-4xl">
          Try vault switching
        </h2>
        <div class="mt-8">
          <ScopeDemo client:load />
        </div>
      </section>

      <section id="comparison" class="mx-auto max-w-6xl scroll-mt-20 px-5 py-14 sm:px-8 sm:py-20">
        <h2 class="text-3xl font-medium tracking-tight text-foreground lg:text-4xl">
          How it compares
        </h2>
        <div class="mt-8 overflow-x-auto rounded-lg border border-border bg-card">
          <table class="w-full min-w-[520px] border-collapse text-left text-sm sm:text-base">
            <thead>
              <tr class="border-b border-border bg-muted">
                <th class="px-5 py-3.5 font-medium text-muted-foreground"></th>
                <th class="px-5 py-3.5 text-center font-medium text-foreground">memtwig</th>
                <th class="px-5 py-3.5 text-center font-medium text-muted-foreground">Cloud Memory APIs</th>
                <th class="px-5 py-3.5 text-center font-medium text-muted-foreground">Static .md files</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-border">
              {matrix.map((row) => (
                <tr>
                  <td class="px-5 py-3.5 font-medium text-foreground">{row.capability}</td>
                  <td class="px-5 py-3.5 text-center">
                    <span class="font-medium text-emerald-400" aria-label="Yes">✓</span>
                  </td>
                  <td class="px-5 py-3.5 text-center text-muted-foreground">
                    {row.cloud === "dash" ? (
                      <span aria-label="No">—</span>
                    ) : (
                      <span class="rounded bg-muted px-2 py-0.5 text-xs text-muted-foreground">{row.cloud}</span>
                    )}
                  </td>
                  <td class="px-5 py-3.5 text-center text-muted-foreground">
                    {row.staticMd === "check" ? (
                      <span class="font-medium text-zinc-300" aria-label="Yes">✓</span>
                    ) : (
                      <span aria-label="No">—</span>
                    )}
                  </td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
        <div class="mt-4 flex flex-wrap gap-6 text-sm text-muted-foreground">
          <a href="/vs/mem0" class="transition-colors hover:text-foreground">Compare vs Mem0 →</a>
          <a href="/vs/claude-md" class="transition-colors hover:text-foreground">Compare vs CLAUDE.md →</a>
        </div>
      </section>

      <section id="install" class="mx-auto max-w-6xl scroll-mt-20 px-5 py-14 sm:px-8 sm:py-20">
        <div class="flex flex-col gap-2 sm:flex-row sm:items-end sm:justify-between">
          <h2 class="text-3xl font-medium tracking-tight text-foreground lg:text-4xl">
            Quickstart
          </h2>
          <a
            href={releasesUrl}
            target="_blank"
            rel="noreferrer"
            class="text-sm font-medium text-muted-foreground transition-colors hover:text-foreground"
          >
            Download prebuilt binaries
          </a>
        </div>
        <div class="mt-8">
          <QuickstartTabs client:load />
        </div>
      </section>

      <section id="faq" class="mx-auto max-w-6xl scroll-mt-20 px-5 py-12 pb-20 sm:px-8 sm:py-16 sm:pb-24">
        <h2 class="text-3xl font-medium tracking-tight text-foreground lg:text-4xl">
          FAQ
        </h2>
        <div class="mt-8 divide-y divide-border rounded-lg border border-border bg-card px-6 sm:px-8">
          {faqs.map((item) => (
            <details class="group py-5">
              <summary class="flex cursor-pointer list-none items-center justify-between gap-4 text-base font-medium text-foreground sm:text-lg [&::-webkit-details-marker]:hidden">
                <span>{item.q}</span>
                <span class="shrink-0 text-muted-foreground transition-transform duration-150 group-open:rotate-45">+</span>
              </summary>
              <p class="mt-3 text-sm leading-relaxed text-muted-foreground sm:text-base">{item.a}</p>
            </details>
          ))}
        </div>
      </section>
    </main>

    <footer class="border-t border-border bg-background">
      <div class="mx-auto flex max-w-6xl flex-col items-center gap-4 px-5 py-10 text-sm text-muted-foreground sm:flex-row sm:justify-between sm:px-8">
        <div class="flex items-center gap-2.5 text-foreground font-medium">
          <img src="/favicon.svg" alt="" width="20" height="20" class="rounded-sm" />
          <span>memtwig</span>
          <span class="text-muted-foreground font-normal">· Apache 2.0</span>
        </div>
        <div class="flex flex-wrap items-center justify-center gap-6">
          <a href="/cloud" class="transition-colors hover:text-foreground">Cloud</a>
          <a href="/integrations" class="transition-colors hover:text-foreground">Integrations</a>
          <a href="/vs/mem0" class="transition-colors hover:text-foreground">vs Mem0</a>
          <a href="/vs/claude-md" class="transition-colors hover:text-foreground">vs CLAUDE.md</a>
          <a href="/mcp-memory" class="transition-colors hover:text-foreground">MCP Memory</a>
          <a href={repoUrl} target="_blank" rel="noreferrer" class="transition-colors hover:text-foreground">GitHub</a>
          <a href={releasesUrl} target="_blank" rel="noreferrer" class="transition-colors hover:text-foreground">Releases</a>
          <a href={docsUrl} target="_blank" rel="noreferrer" class="transition-colors hover:text-foreground">Docs</a>
          <a href="/llms.txt" class="transition-colors hover:text-foreground">llms.txt</a>
          <span>© 2026 Vittorio Compagno</span>
        </div>
      </div>
    </footer>
  </body>
</html>
