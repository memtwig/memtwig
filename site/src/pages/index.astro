---
import "@/styles/global.css";
import { buttonVariants } from "@/components/ui/button";
import { cn } from "@/lib/utils";
import { MobileNav } from "@/components/MobileNav";
import { ScopeDemo } from "@/components/ScopeDemo";
import { QuickstartTabs } from "@/components/QuickstartTabs";

const repoUrl = "https://github.com/vittoriocompagno/memtwig";
const releasesUrl = "https://github.com/vittoriocompagno/memtwig/releases";
const docsUrl = "https://github.com/vittoriocompagno/memtwig/tree/main/docs";

const metrics = [
  { value: "105 ms", label: "109 Markdown notes indexed into SQLite FTS5" },
  { value: "12 MB", label: "Single static Go binary, zero CGO" },
  { value: "0", label: "External vector databases required" },
];

const pillars = [
  {
    title: "Git + Markdown",
    body: "Every vault is a plain Git repository. Notes use YAML frontmatter or lightweight headers, an 8 KB soft cap, and append-only archives instead of silent deletion.",
  },
  {
    title: "Hybrid FTS5 + RRF",
    body: "Local SQLite FTS5 BM25 fused with optional Ollama, OpenAI, or Cloudflare embeddings via Reciprocal Rank Fusion. Degrades cleanly to BM25 offline.",
  },
  {
    title: "Proposals + RBAC",
    body: "Org vaults and owner-locked notes block direct agent writes. Agents queue deterministic proposals in .curator/proposals.json; rejected IDs never reopen.",
  },
];

const comparison = [
  {
    dimension: "Storage format",
    memtwig: "Plain Markdown in Git",
    vectorApi: "Proprietary cloud DB",
    staticFiles: "Unindexed flat files",
  },
  {
    dimension: "Multi-org isolation",
    memtwig: "cwd & git remote routing in SQL",
    vectorApi: "Manual tenant IDs in app code",
    staticFiles: "Per-repo only",
  },
  {
    dimension: "Agent write safety",
    memtwig: "owner-lock + proposal queue",
    vectorApi: "Autonomous overwrite",
    staticFiles: "Unrestricted edits",
  },
  {
    dimension: "Secret scanning",
    memtwig: "Built-in linter blocks sync",
    vectorApi: "None",
    staticFiles: "Manual hooks",
  },
  {
    dimension: "Cross-harness",
    memtwig: "CLI, stdio/HTTP MCP, native hooks",
    vectorApi: "SDK integration required",
    staticFiles: "Tool-specific filenames",
  },
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>memtwig — Git-native, multi-org memory layer for AI agents</title>
    <meta
      name="description"
      content="Curated Markdown vaults routed by Git remote. One static Go binary for Claude Code, Codex, and Cursor."
    />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  </head>
  <body class="min-h-screen text-foreground">
    <div class="sticky top-4 z-40 px-4 sm:px-6">
      <header class="mx-auto flex h-14 max-w-4xl items-center justify-between rounded-full border border-white/85 bg-white/70 px-3 pl-4 shadow-[0_10px_34px_rgba(15,58,55,0.08)] ring-1 ring-border backdrop-blur-xl">
        <a href="#" class="flex items-center gap-2.5 text-base font-semibold tracking-tight text-foreground">
          <img src="/favicon.svg" alt="" width="24" height="24" class="rounded-md" />
          <span>memtwig</span>
        </a>

        <nav class="hidden items-center gap-1 md:flex">
          <a href="#isolation" class="rounded-full px-3.5 py-1.5 text-sm font-medium text-muted-foreground transition-colors hover:bg-muted/70 hover:text-foreground">Isolation</a>
          <a href="#architecture" class="rounded-full px-3.5 py-1.5 text-sm font-medium text-muted-foreground transition-colors hover:bg-muted/70 hover:text-foreground">Architecture</a>
          <a href="#comparison" class="rounded-full px-3.5 py-1.5 text-sm font-medium text-muted-foreground transition-colors hover:bg-muted/70 hover:text-foreground">Comparison</a>
          <a href={docsUrl} target="_blank" rel="noreferrer" class="rounded-full px-3.5 py-1.5 text-sm font-medium text-muted-foreground transition-colors hover:bg-muted/70 hover:text-foreground">Docs</a>
        </nav>

        <div class="hidden items-center gap-2 md:flex">
          <a href={repoUrl} target="_blank" rel="noreferrer" class={cn(buttonVariants({ variant: "ghost", size: "sm" }))}>
            GitHub
          </a>
          <a href="#install" class={cn(buttonVariants({ variant: "default", size: "sm" }))}>
            Install
          </a>
        </div>

        <div class="md:hidden">
          <MobileNav client:media="(max-width: 767px)" />
        </div>
      </header>
    </div>

    <main class="relative z-10">
      <section class="mx-auto max-w-5xl px-5 pt-16 pb-16 sm:px-8 sm:pt-24 sm:pb-24">
        <div class="mx-auto max-w-4xl text-center">
          <h1 class="text-balance text-4xl font-normal tracking-tight text-foreground sm:text-6xl xl:text-7xl leading-[1.06]">
            Git-native memory for AI agents across every org.
          </h1>
          <p class="mx-auto mt-5 max-w-xl text-base text-muted-foreground sm:text-lg leading-relaxed">
            Curated Markdown vaults routed by Git remote. One Go binary for every harness.
          </p>
          <div class="mt-9 flex flex-wrap items-center justify-center gap-3">
            <a href="#install" class={cn(buttonVariants({ size: "lg" }))}>Install v1.0.0</a>
            <a
              href={repoUrl}
              target="_blank"
              rel="noreferrer"
              class={cn(buttonVariants({ variant: "outline", size: "lg" }))}
            >
              View on GitHub
            </a>
          </div>
        </div>

        <div id="isolation" class="mt-14 scroll-mt-24">
          <ScopeDemo client:load />
        </div>
      </section>

      <section class="mx-auto max-w-5xl px-5 py-10 sm:px-8">
        <div class="grid gap-4 sm:grid-cols-3">
          {metrics.map((m) => (
            <div class="rounded-3xl border border-white/80 bg-white/60 p-6 text-center shadow-[0_10px_30px_rgba(15,58,55,0.05)] ring-1 ring-border backdrop-blur-xl">
              <div class="text-4xl font-light tracking-tight text-foreground tabular-nums sm:text-5xl">
                {m.value}
              </div>
              <p class="mt-2.5 text-sm text-muted-foreground">{m.label}</p>
            </div>
          ))}
        </div>
      </section>

      <section id="architecture" class="mx-auto max-w-5xl scroll-mt-24 px-5 py-16 sm:px-8 sm:py-24">
        <h2 class="text-center text-3xl font-medium tracking-tight text-foreground lg:text-4xl">
          Architecture
        </h2>
        <div class="mt-10 grid gap-5 md:grid-cols-3">
          {pillars.map((item) => (
            <div class="space-y-2.5 rounded-3xl border border-white/80 bg-white/60 p-6 shadow-[0_10px_30px_rgba(15,58,55,0.05)] ring-1 ring-border backdrop-blur-xl">
              <h3 class="text-xl font-medium text-foreground">{item.title}</h3>
              <p class="text-base leading-relaxed text-muted-foreground">{item.body}</p>
            </div>
          ))}
        </div>
      </section>

      <section id="comparison" class="mx-auto max-w-5xl scroll-mt-24 px-5 py-12 sm:px-8 sm:py-20">
        <h2 class="text-center text-3xl font-medium tracking-tight text-foreground lg:text-4xl">
          How it compares
        </h2>
        <div class="mt-8 overflow-x-auto rounded-3xl border border-white/80 bg-white/65 shadow-[0_12px_36px_rgba(15,58,55,0.06)] ring-1 ring-border backdrop-blur-xl">
          <table class="w-full min-w-[600px] border-collapse text-left text-sm sm:text-base">
            <thead>
              <tr class="border-b border-border bg-muted/50">
                <th class="px-5 py-4 font-semibold text-foreground">Capability</th>
                <th class="px-5 py-4 font-semibold text-primary">memtwig</th>
                <th class="px-5 py-4 font-semibold text-foreground">Vector Memory APIs</th>
                <th class="px-5 py-4 font-semibold text-foreground">Static Rules Files</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-border/70">
              {comparison.map((row) => (
                <tr>
                  <td class="px-5 py-4 font-medium text-foreground">{row.dimension}</td>
                  <td class="px-5 py-4 text-foreground">{row.memtwig}</td>
                  <td class="px-5 py-4 text-muted-foreground">{row.vectorApi}</td>
                  <td class="px-5 py-4 text-muted-foreground">{row.staticFiles}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </section>

      <section id="install" class="mx-auto max-w-5xl scroll-mt-24 px-5 py-16 sm:px-8 sm:py-24">
        <div class="text-center">
          <h2 class="text-3xl font-medium tracking-tight text-foreground lg:text-4xl">
            Quickstart
          </h2>
          <a
            href={releasesUrl}
            target="_blank"
            rel="noreferrer"
            class="mt-3 inline-block text-sm font-medium text-primary hover:underline"
          >
            Download prebuilt binaries (Linux, macOS, Windows)
          </a>
        </div>
        <div class="mt-8">
          <QuickstartTabs client:load />
        </div>
      </section>
    </main>

    <footer class="border-t border-border/80 bg-white/50 backdrop-blur-md">
      <div class="mx-auto flex max-w-5xl flex-col items-center gap-4 px-5 py-10 text-sm text-muted-foreground sm:flex-row sm:justify-between sm:px-8">
        <div class="flex items-center gap-2.5 text-foreground font-medium">
          <img src="/favicon.svg" alt="" width="20" height="20" class="rounded-sm" />
          <span>memtwig</span>
          <span class="text-muted-foreground font-normal">· Apache 2.0</span>
        </div>
        <div class="flex flex-wrap items-center justify-center gap-6">
          <a href={repoUrl} target="_blank" rel="noreferrer" class="hover:text-foreground">GitHub</a>
          <a href={releasesUrl} target="_blank" rel="noreferrer" class="hover:text-foreground">Releases</a>
          <a href={docsUrl} target="_blank" rel="noreferrer" class="hover:text-foreground">Docs</a>
          <span>© 2026 Vittorio Compagno</span>
        </div>
      </div>
    </footer>
  </body>
</html>
