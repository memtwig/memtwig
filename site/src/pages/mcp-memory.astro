---
import ArticleLayout from "@/layouts/ArticleLayout.astro";
import VsDiagram from "@/components/VsDiagram.astro";
import { buttonVariants } from "@/components/ui/button";
import { cn } from "@/lib/utils";

const tools = [
  { name: "memory_search", desc: "Scoped local keyword + optional vector search across active vaults." },
  { name: "memory_read", desc: "Read a Markdown note with path-traversal and scope enforcement." },
  { name: "memory_write", desc: "Direct write allowed only on unlocked direct vaults." },
  { name: "memory_propose", desc: "Queue deterministic create, update, or append diff proposals." },
  { name: "memory_decide", desc: "Log a dated decision and propose linking it on the target project note." },
  { name: "memory_status", desc: "Inspect resolved vaults, write modes, and open proposal counts." },
];

const faqs = [
  {
    q: "Does memtwig support both local stdio and remote HTTP MCP?",
    a: "Yes. Run 'memtwig mcp' for local stdio clients or 'memtwig serve' for Streamable HTTP MCP and REST endpoints with RBAC and audit logging.",
  },
  {
    q: "How does RBAC work on the HTTP MCP server?",
    a: "Each Bearer token policy defines a role (reader, proposer, writer, admin), allowed vaults, and optional path globs.",
  },
];
---

<ArticleLayout
  title="Open-Source MCP Memory Server (Git + Markdown)"
  description="Single-binary Go MCP memory server for Claude Code, Cursor, Codex, and team deployments with SQLite FTS5, multi-org isolation, RBAC, and audit logs."
  path="/mcp-memory"
  faqs={faqs}
>
  <header class="max-w-3xl">
    <h1 class="text-balance text-4xl font-normal tracking-tight text-foreground sm:text-5xl leading-[1.06]">
      Open-source MCP memory server.
    </h1>
    <p class="mt-4 text-base leading-relaxed text-muted-foreground sm:text-lg">
      One Go binary speaking stdio MCP locally and Streamable HTTP with RBAC for teams.
    </p>
  </header>

  <section class="mt-10">
    <VsDiagram variant="mcp" />
  </section>

  <section class="mt-10 overflow-x-auto rounded-lg border border-border bg-card">
    <table class="w-full min-w-[520px] border-collapse text-left text-sm sm:text-base">
      <thead>
        <tr class="border-b border-border bg-muted">
          <th class="px-5 py-3.5 font-medium text-foreground">MCP Tool</th>
          <th class="px-5 py-3.5 font-medium text-muted-foreground">Behavior</th>
        </tr>
      </thead>
      <tbody class="divide-y divide-border">
        {tools.map((t) => (
          <tr>
            <td class="px-5 py-3.5">
              <span class="rounded bg-muted px-2 py-0.5 text-xs font-medium text-emerald-400">
                {t.name}
              </span>
            </td>
            <td class="px-5 py-3.5 text-muted-foreground">{t.desc}</td>
          </tr>
        ))}
      </tbody>
    </table>
  </section>

  <section class="mt-10 grid gap-4 sm:grid-cols-2">
    <div class="overflow-hidden rounded-lg border border-border bg-[#0b0b0e]">
      <div class="flex items-center justify-between border-b border-border bg-card px-5 py-3">
        <span class="text-sm font-medium text-foreground">Local stdio</span>
        <span class="text-xs text-muted-foreground">mcp.json</span>
      </div>
      <pre class="overflow-x-auto p-5 text-sm leading-relaxed text-zinc-200"><code>{`{
  "mcpServers": {
    "memtwig": {
      "command": "memtwig",
      "args": ["mcp"]
    }
  }
}`}</code></pre>
    </div>

    <div class="overflow-hidden rounded-lg border border-border bg-[#0b0b0e]">
      <div class="flex items-center justify-between border-b border-border bg-card px-5 py-3">
        <span class="text-sm font-medium text-foreground">Team HTTP + RBAC</span>
        <span class="text-xs text-muted-foreground">shell</span>
      </div>
      <pre class="overflow-x-auto p-5 text-sm leading-relaxed text-zinc-200"><code>{`memtwig serve --addr 127.0.0.1:8787

# POST /mcp
# GET  /api/v1/search?q=deploy
# POST /api/v1/proposals
# GET  /api/v1/audit`}</code></pre>
    </div>
  </section>

  <div class="mt-10 flex flex-wrap gap-3">
    <a href="/#install" class={cn(buttonVariants({ size: "lg" }))}>Install v1.4.2</a>
    <a href="/vs/mem0" class={cn(buttonVariants({ variant: "outline", size: "lg" }))}>
      Compare vs Mem0
    </a>
  </div>
</ArticleLayout>
