---
import ArticleLayout from "@/layouts/ArticleLayout.astro";
import { buttonVariants } from "@/components/ui/button";
import { cn } from "@/lib/utils";

const tools = [
  { name: "memory_search", desc: "Hybrid SQLite FTS5 BM25 + vector RRF search scoped to active vaults in cwd." },
  { name: "memory_read", desc: "Read a specific Markdown note with path-traversal and scope enforcement." },
  { name: "memory_write", desc: "Direct write allowed only on direct vaults and non-owner-locked notes." },
  { name: "memory_propose", desc: "Queue deterministic create/update/append proposals into .curator/proposals.json." },
  { name: "memory_decide", desc: "Log a dated decision in decisions/YYYY-MM.md and link/propose it on the project note." },
  { name: "memory_status", desc: "Inspect resolved vaults, write modes, match reasons, and open proposal counts." },
];

const faqs = [
  {
    q: "Does memtwig support both local stdio and remote HTTP MCP?",
    a: "Yes. Run 'memtwig mcp' for local stdio clients (Claude Code, Cursor, Codex, Antigravity) or 'memtwig serve --addr 127.0.0.1:8787' for Streamable HTTP MCP (/mcp) plus REST API endpoints protected by Bearer token RBAC and append-only audit.jsonl.",
  },
  {
    q: "How does RBAC work on the HTTP MCP server?",
    a: "Each token policy in config.toml defines a role (reader, proposer, writer, admin), allowed vaults, and optional path globs. A proposer token for client A cannot read client B or overwrite owner-locked files.",
  },
];
---

<ArticleLayout
  title="Open-Source MCP Memory Server (Git + Markdown)"
  description="Single-binary Go MCP memory server for Claude Code, Cursor, Codex, and team deployments with SQLite FTS5, multi-org isolation, RBAC, and audit logs."
  path="/mcp-memory"
  faqs={faqs}
>
  <header class="text-center">
    <h1 class="text-balance text-4xl font-normal tracking-tight text-foreground sm:text-5xl leading-[1.08]">
      Open-source MCP memory server for multi-org teams.
    </h1>
    <p class="mx-auto mt-5 max-w-2xl text-base leading-relaxed text-muted-foreground sm:text-lg">
      memtwig ships a zero-dependency Model Context Protocol server over stdio and Streamable HTTP. Every tool call enforces workspace vault isolation, owner-lock rules, and role-based access control.
    </p>
  </header>

  <section class="mt-12 overflow-x-auto rounded-3xl border border-white/80 bg-white/65 shadow-[0_12px_36px_rgba(15,58,55,0.06)] ring-1 ring-border backdrop-blur-xl">
    <table class="w-full min-w-[540px] border-collapse text-left text-sm sm:text-base">
      <thead>
        <tr class="border-b border-border bg-muted/50">
          <th class="px-5 py-4 font-semibold text-primary">MCP Tool</th>
          <th class="px-5 py-4 font-semibold text-foreground">Behavior</th>
        </tr>
      </thead>
      <tbody class="divide-y divide-border/70">
        {tools.map((t) => (
          <tr>
            <td class="px-5 py-4 font-medium text-foreground">{t.name}</td>
            <td class="px-5 py-4 text-muted-foreground">{t.desc}</td>
          </tr>
        ))}
      </tbody>
    </table>
  </section>

  <section class="mt-12 grid gap-5 sm:grid-cols-2">
    <div class="rounded-3xl border border-white/80 bg-white/60 p-6 shadow-[0_10px_30px_rgba(15,58,55,0.05)] ring-1 ring-border backdrop-blur-xl">
      <h2 class="text-xl font-medium text-foreground">Local stdio (Cursor / Claude / Codex)</h2>
      <pre class="mt-4 overflow-x-auto text-sm leading-relaxed text-foreground"><code>{`{
  "mcpServers": {
    "memtwig": {
      "command": "memtwig",
      "args": ["mcp"]
    }
  }
}`}</code></pre>
    </div>

    <div class="rounded-3xl border border-white/80 bg-white/60 p-6 shadow-[0_10px_30px_rgba(15,58,55,0.05)] ring-1 ring-border backdrop-blur-xl">
      <h2 class="text-xl font-medium text-foreground">Team HTTP MCP + RBAC</h2>
      <pre class="mt-4 overflow-x-auto text-sm leading-relaxed text-foreground"><code>{`memtwig serve --addr 127.0.0.1:8787

# Endpoints:
# POST /mcp
# GET  /api/v1/search?q=deploy
# POST /api/v1/proposals
# GET  /api/v1/audit`}</code></pre>
    </div>
  </section>

  <div class="mt-12 flex flex-wrap justify-center gap-3">
    <a href="/#install" class={cn(buttonVariants({ size: "lg" }))}>Install memtwig v1.0.0</a>
    <a href="/vs/mem0" class={cn(buttonVariants({ variant: "outline", size: "lg" }))}>
      Compare with Mem0
    </a>
  </div>
</ArticleLayout>
