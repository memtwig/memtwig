---
import ArticleLayout from "@/layouts/ArticleLayout.astro";
import VsDiagram from "@/components/VsDiagram.astro";
import { buttonVariants } from "@/components/ui/button";
import { cn } from "@/lib/utils";

const rows = [
  { dim: "Context cost", memtwig: "Top-K snippets (~400 chars)", staticMd: "Full file in every prompt" },
  { dim: "Tool portability", memtwig: "Shared across all coding agents", staticMd: "Split across tool filenames" },
  { dim: "Multi-repo & clients", memtwig: "Per-org vaults + shared personal rules", staticMd: "Copied manually per repo" },
  { dim: "Hygiene & size", memtwig: "8 KB soft cap + append-only archives", staticMd: "Grows until rules conflict" },
  { dim: "Agent edits", memtwig: "Locked notes + diff proposals", staticMd: "Unchecked direct edits" },
  { dim: "Secret safety", memtwig: "Scanner blocks sync", staticMd: "None" },
];

const keepLocal = [
  "Repo-specific build, test, and lint commands.",
  "Folder layout notes tied only to that single codebase.",
];

const moveToMemtwig = [
  "Client infrastructure, deploy URLs, and server details.",
  "Personal coding preferences shared across every tool.",
  "Dated project decisions and architecture history.",
];

const faqs = [
  {
    q: "Do I have to delete my existing CLAUDE.md or AGENTS.md files?",
    a: "No. Keep repo-local build commands in CLAUDE.md, and use memtwig for cross-repo facts, client vaults, and personal rules.",
  },
  {
    q: "How fast is memtwig compared to loading raw Markdown files?",
    a: "Indexing 109 notes takes roughly half a second locally, and per-turn hook search returns only matching snippets while skipping courtesy messages.",
  },
];
---

<ArticleLayout
  title="memtwig vs CLAUDE.md"
  description="Why static CLAUDE.md and .cursorrules files break across multiple repositories and harnesses, and how memtwig scales Markdown memory with FTS5, multi-org routing, and curation."
  path="/vs/claude-md"
  faqs={faqs}
>
  <header class="max-w-3xl">
    <h1 class="text-balance text-4xl font-normal tracking-tight text-foreground sm:text-5xl leading-[1.06]">
      memtwig vs CLAUDE.md
    </h1>
    <p class="mt-4 text-base leading-relaxed text-muted-foreground sm:text-lg">
      Top-K snippets shared across every agent vs static rule files duplicated per repo.
    </p>
  </header>

  <section class="mt-10">
    <VsDiagram variant="claude-md" />
  </section>

  <section class="mt-10 overflow-x-auto rounded-lg border border-border bg-card">
    <table class="w-full min-w-[540px] border-collapse text-left text-sm sm:text-base">
      <thead>
        <tr class="border-b border-border bg-muted">
          <th class="px-5 py-3.5 font-medium text-muted-foreground">Dimension</th>
          <th class="px-5 py-3.5 font-medium text-foreground">
            <span class="inline-flex items-center gap-2">
              <span class="h-1.5 w-1.5 rounded-full bg-emerald-400"></span>
              memtwig
            </span>
          </th>
          <th class="px-5 py-3.5 font-medium text-muted-foreground">CLAUDE.md / .cursorrules</th>
        </tr>
      </thead>
      <tbody class="divide-y divide-border">
        {rows.map((r) => (
          <tr>
            <td class="px-5 py-3.5 font-medium text-foreground">{r.dim}</td>
            <td class="px-5 py-3.5 text-foreground">{r.memtwig}</td>
            <td class="px-5 py-3.5 text-muted-foreground">{r.staticMd}</td>
          </tr>
        ))}
      </tbody>
    </table>
  </section>

  <section class="mt-10 grid gap-4 sm:grid-cols-2">
    <div class="rounded-lg border border-border bg-card p-6">
      <h2 class="flex items-center gap-2 text-lg font-medium text-foreground">
        <span class="h-2 w-2 rounded-full bg-zinc-500"></span>
        Keep CLAUDE.md for
      </h2>
      <ul class="mt-4 space-y-2.5 text-sm leading-relaxed text-muted-foreground sm:text-base">
        {keepLocal.map((item) => (
          <li class="flex items-start gap-2.5">
            <span class="mt-2 h-1 w-1 shrink-0 rounded-full bg-zinc-500"></span>
            <span>{item}</span>
          </li>
        ))}
      </ul>
    </div>
    <div class="rounded-lg border border-border bg-card p-6">
      <h2 class="flex items-center gap-2 text-lg font-medium text-foreground">
        <span class="h-2 w-2 rounded-full bg-emerald-400"></span>
        Use memtwig for
      </h2>
      <ul class="mt-4 space-y-2.5 text-sm leading-relaxed text-muted-foreground sm:text-base">
        {moveToMemtwig.map((item) => (
          <li class="flex items-start gap-2.5">
            <span class="mt-2 h-1 w-1 shrink-0 rounded-full bg-emerald-400"></span>
            <span>{item}</span>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section class="mt-10 overflow-hidden rounded-lg border border-border bg-[#0b0b0e]">
    <div class="flex items-center justify-between border-b border-border bg-card px-5 py-3">
      <span class="text-sm font-medium text-foreground">Migrate in 30 seconds</span>
      <span class="text-xs text-muted-foreground">shell</span>
    </div>
    <pre class="overflow-x-auto p-5 text-sm leading-relaxed text-zinc-200"><code>{`memtwig migrate personal ~/notes --kind personal --always-include "persona/**"
memtwig index
memtwig install claude
memtwig install cursor
memtwig install codex`}</code></pre>
  </section>

  <div class="mt-10 flex flex-wrap gap-3">
    <a href="/#install" class={cn(buttonVariants({ size: "lg" }))}>Install v1.4.2</a>
    <a href="/mcp-memory" class={cn(buttonVariants({ variant: "outline", size: "lg" }))}>
      Explore MCP Memory Server
    </a>
  </div>
</ArticleLayout>
