---
import ArticleLayout from "@/layouts/ArticleLayout.astro";
import { buttonVariants } from "@/components/ui/button";
import { cn } from "@/lib/utils";

const rows = [
  { dim: "Primary storage", memtwig: "Plain Markdown files in Git repos", mem0: "Vector DB + optional Graph DB" },
  { dim: "Runtime dependencies", memtwig: "Single 12 MB static Go binary (SQLite FTS5 embedded)", mem0: "Python/Node SDK + vector store + LLM API key" },
  { dim: "Offline operation", memtwig: "Full BM25 search & curation offline", mem0: "Requires LLM extraction & embedding APIs" },
  { dim: "Multi-org isolation", memtwig: "Automatic cwd & git remote routing in SQL", mem0: "Manual user_id / org_id scoping in app code" },
  { dim: "Write governance", memtwig: "owner-lock + deterministic proposal queue (.curator/proposals.json)", mem0: "Autonomous background fact extraction & overwrites" },
  { dim: "Secret protection", memtwig: "Built-in secret scanner blocks sync", mem0: "Not built in" },
  { dim: "Coding harness support", memtwig: "Native hooks (Claude Code, Codex, Antigravity) + stdio/HTTP MCP", mem0: "Primarily app-level SDK / API" },
  { dim: "Best suited for", memtwig: "Developers, freelancers, and teams sharing curated knowledge across harnesses", mem0: "Consumer or SaaS apps storing per-user chat personalization" },
];

const faqs = [
  {
    q: "Is memtwig a drop-in replacement for Mem0?",
    a: "They solve different layers. Mem0 is built as a runtime API for SaaS applications that extract per-user preferences from chat logs. memtwig is a git-native, curated Markdown memory layer for developers, freelancers, and engineering teams using coding agents across multiple repositories and organizations.",
  },
  {
    q: "Can memtwig use vector embeddings like Mem0?",
    a: "Yes. memtwig fuses local SQLite FTS5 BM25 with optional Ollama, OpenAI, or Cloudflare embeddings via Reciprocal Rank Fusion (k=60), and degrades automatically to BM25 when offline.",
  },
  {
    q: "Why store memory in Git instead of a vector database?",
    a: "Git provides human readability, diffs, blame, rollbacks, and zero vendor lock-in. Humans and agents share the exact same Markdown source of truth while SQLite FTS5 acts purely as a rebuildable local index.",
  },
];
---

<ArticleLayout
  title="memtwig vs Mem0"
  description="Direct comparison between memtwig (git-native Markdown memory layer in Go) and Mem0 (vector/graph memory API) for AI coding agents and multi-org teams."
  path="/vs/mem0"
  faqs={faqs}
>
  <header class="text-center">
    <h1 class="text-balance text-4xl font-normal tracking-tight text-foreground sm:text-5xl leading-[1.08]">
      memtwig vs Mem0
    </h1>
    <p class="mx-auto mt-5 max-w-2xl text-base leading-relaxed text-muted-foreground sm:text-lg">
      Choose memtwig when you want human-readable Markdown in Git, automatic multi-org isolation by Git remote, and proposal-gated agent writes in one 12 MB Go binary. Choose Mem0 when you need an embedded SDK API for per-user chat memory inside a SaaS product.
    </p>
  </header>

  <section class="mt-12 overflow-x-auto rounded-3xl border border-white/80 bg-white/65 shadow-[0_12px_36px_rgba(15,58,55,0.06)] ring-1 ring-border backdrop-blur-xl">
    <table class="w-full min-w-[580px] border-collapse text-left text-sm sm:text-base">
      <thead>
        <tr class="border-b border-border bg-muted/50">
          <th class="px-5 py-4 font-semibold text-foreground">Dimension</th>
          <th class="px-5 py-4 font-semibold text-primary">memtwig (v1.0.0)</th>
          <th class="px-5 py-4 font-semibold text-foreground">Mem0</th>
        </tr>
      </thead>
      <tbody class="divide-y divide-border/70">
        {rows.map((r) => (
          <tr>
            <td class="px-5 py-4 font-medium text-foreground">{r.dim}</td>
            <td class="px-5 py-4 text-foreground">{r.memtwig}</td>
            <td class="px-5 py-4 text-muted-foreground">{r.mem0}</td>
          </tr>
        ))}
      </tbody>
    </table>
  </section>

  <section class="mt-12 grid gap-5 sm:grid-cols-2">
    <div class="rounded-3xl border border-white/80 bg-white/60 p-6 shadow-[0_10px_30px_rgba(15,58,55,0.05)] ring-1 ring-border backdrop-blur-xl">
      <h2 class="text-xl font-medium text-foreground">When memtwig wins</h2>
      <ul class="mt-4 space-y-2.5 text-sm leading-relaxed text-muted-foreground sm:text-base">
        <li>You switch between multiple client repos and need hard isolation across vaults.</li>
        <li>You use Claude Code, Codex, and Cursor together and want one shared memory layer.</li>
        <li>You refuse autonomous memory overwrites and want reviewable proposals with secret scanning.</li>
      </ul>
    </div>
    <div class="rounded-3xl border border-white/80 bg-white/60 p-6 shadow-[0_10px_30px_rgba(15,58,55,0.05)] ring-1 ring-border backdrop-blur-xl">
      <h2 class="text-xl font-medium text-foreground">When Mem0 wins</h2>
      <ul class="mt-4 space-y-2.5 text-sm leading-relaxed text-muted-foreground sm:text-base">
        <li>You are building a multi-user consumer or B2B chat app that needs a drop-in cloud API.</li>
        <li>You want automatic background fact extraction from conversational transcripts without Markdown files.</li>
        <li>Your team prefers managed cloud infrastructure over Git-backed knowledge bases.</li>
      </ul>
    </div>
  </section>

  <div class="mt-12 flex flex-wrap justify-center gap-3">
    <a href="/#install" class={cn(buttonVariants({ size: "lg" }))}>Install memtwig v1.0.0</a>
    <a href="https://github.com/vittoriocompagno/memtwig" target="_blank" rel="noreferrer" class={cn(buttonVariants({ variant: "outline", size: "lg" }))}>
      View on GitHub
    </a>
  </div>
</ArticleLayout>
