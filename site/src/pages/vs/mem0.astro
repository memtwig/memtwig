---
import ArticleLayout from "@/layouts/ArticleLayout.astro";
import VsDiagram from "@/components/VsDiagram.astro";
import { buttonVariants } from "@/components/ui/button";
import { cn } from "@/lib/utils";

const rows = [
  { dim: "Primary storage", memtwig: "Plain Markdown in Git", mem0: "Vector + Graph DB" },
  { dim: "Runtime footprint", memtwig: "Single 14 MB Go binary", mem0: "SDK + DB + LLM API key" },
  { dim: "Offline operation", memtwig: "Full search & UI offline", mem0: "Requires cloud APIs" },
  { dim: "Client isolation", memtwig: "Automatic cwd & remote routing", mem0: "Manual tenant IDs" },
  { dim: "Write safety", memtwig: "Locked notes + diff proposals", mem0: "Background overwrites" },
  { dim: "Secret protection", memtwig: "Built-in scanner blocks sync", mem0: "Not built in" },
  { dim: "Coding agents", memtwig: "Native hooks + MCP + Studio UI", mem0: "App-level SDK" },
];

const memtwigWins = [
  "You switch between multiple client repos and need strict isolation.",
  "You use Claude Code, Codex, and Cursor on one shared vault.",
  "You want plain Git diffs instead of silent memory overwrites.",
];

const mem0Wins = [
  "You are building a SaaS app that needs per-user chat memory.",
  "You want automatic background fact extraction from chat logs.",
  "Your product already runs managed vector infrastructure.",
];

const faqs = [
  {
    q: "Is memtwig a drop-in replacement for Mem0?",
    a: "They target different layers: Mem0 is an app SDK for SaaS chat personalization, while memtwig is local Git-native memory for coding agents across repositories.",
  },
  {
    q: "Can memtwig use vector embeddings like Mem0?",
    a: "Yes. You can enable Ollama, OpenRouter, DeepInfra, OpenAI, or Cloudflare embeddings anytime, while keeping local keyword search working offline.",
  },
  {
    q: "Why keep memory in Git instead of a vector database?",
    a: "Git gives you readable diffs, rollbacks, and zero vendor lock-in while the local SQLite index stays completely rebuildable.",
  },
];
---

<ArticleLayout
  title="memtwig vs Mem0"
  description="Direct comparison between memtwig (git-native Markdown memory layer in Go) and Mem0 (vector/graph memory API) for AI coding agents and multi-org teams."
  path="/vs/mem0"
  faqs={faqs}
>
  <header class="max-w-3xl">
    <h1 class="text-balance text-4xl font-normal tracking-tight text-foreground sm:text-5xl leading-[1.06]">
      memtwig vs Mem0
    </h1>
    <p class="mt-4 text-base leading-relaxed text-muted-foreground sm:text-lg">
      Local Git Markdown vaults with diff approval vs cloud vector extraction APIs.
    </p>
  </header>

  <section class="mt-10">
    <VsDiagram variant="mem0" />
  </section>

  <section class="mt-10 overflow-x-auto rounded-lg border border-border bg-card">
    <table class="w-full min-w-[540px] border-collapse text-left text-sm sm:text-base">
      <thead>
        <tr class="border-b border-border bg-muted">
          <th class="px-5 py-3.5 font-medium text-muted-foreground">Dimension</th>
          <th class="px-5 py-3.5 font-medium text-foreground">
            <span class="inline-flex items-center gap-2">
              <span class="h-1.5 w-1.5 rounded-full bg-emerald-400"></span>
              memtwig
            </span>
          </th>
          <th class="px-5 py-3.5 font-medium text-muted-foreground">Mem0</th>
        </tr>
      </thead>
      <tbody class="divide-y divide-border">
        {rows.map((r) => (
          <tr>
            <td class="px-5 py-3.5 font-medium text-foreground">{r.dim}</td>
            <td class="px-5 py-3.5 text-foreground">{r.memtwig}</td>
            <td class="px-5 py-3.5 text-muted-foreground">{r.mem0}</td>
          </tr>
        ))}
      </tbody>
    </table>
  </section>

  <section class="mt-10 grid gap-4 sm:grid-cols-2">
    <div class="rounded-lg border border-border bg-card p-6">
      <h2 class="flex items-center gap-2 text-lg font-medium text-foreground">
        <span class="h-2 w-2 rounded-full bg-emerald-400"></span>
        Choose memtwig when
      </h2>
      <ul class="mt-4 space-y-2.5 text-sm leading-relaxed text-muted-foreground sm:text-base">
        {memtwigWins.map((item) => (
          <li class="flex items-start gap-2.5">
            <span class="mt-2 h-1 w-1 shrink-0 rounded-full bg-emerald-400"></span>
            <span>{item}</span>
          </li>
        ))}
      </ul>
    </div>
    <div class="rounded-lg border border-border bg-card p-6">
      <h2 class="flex items-center gap-2 text-lg font-medium text-foreground">
        <span class="h-2 w-2 rounded-full bg-zinc-600"></span>
        Choose Mem0 when
      </h2>
      <ul class="mt-4 space-y-2.5 text-sm leading-relaxed text-muted-foreground sm:text-base">
        {mem0Wins.map((item) => (
          <li class="flex items-start gap-2.5">
            <span class="mt-2 h-1 w-1 shrink-0 rounded-full bg-zinc-600"></span>
            <span>{item}</span>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <div class="mt-10 flex flex-wrap gap-3">
    <a href="/#install" class={cn(buttonVariants({ size: "lg" }))}>Install v1.4.2</a>
    <a href="/vs/claude-md" class={cn(buttonVariants({ variant: "outline", size: "lg" }))}>
      Compare vs CLAUDE.md
    </a>
    <a href="https://github.com/memtwig/memtwig" target="_blank" rel="noreferrer" class={cn(buttonVariants({ variant: "ghost", size: "lg" }))}>
      View on GitHub
    </a>
  </div>
</ArticleLayout>
