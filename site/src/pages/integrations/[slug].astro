---
import ArticleLayout from "@/layouts/ArticleLayout.astro";
import IntegrationDiagram from "@/components/IntegrationDiagram.astro";
import { CodeBlock } from "@/components/CodeBlock";
import { integrations, type Integration } from "@/data/integrations";
import { buttonVariants } from "@/components/ui/button";
import { cn } from "@/lib/utils";

export function getStaticPaths() {
  return integrations.map((integration) => ({
    params: { slug: integration.slug },
    props: { integration },
  }));
}

interface Props {
  integration: Integration;
}

const { integration } = Astro.props;
const others = integrations.filter((item) => item.slug !== integration.slug);
---

<ArticleLayout
  title={`Use memtwig with ${integration.name}`}
  description={integration.description}
  path={`/integrations/${integration.slug}`}
  faqs={integration.faqs}
>
  <div>
    <a
      href="/integrations"
      class="inline-block text-sm font-medium text-zinc-400 transition-colors hover:text-white"
    >
      ← All integrations
    </a>
  </div>

  <header class="mt-6 max-w-3xl">
    <div class="flex flex-wrap items-center gap-3">
      <h1 class="text-balance text-5xl font-medium leading-[1.04] tracking-[-0.04em] text-white sm:text-6xl">
        Use memtwig with {integration.name}
      </h1>
      <span class="rounded-full bg-[#58cc7d]/15 px-3 py-1 text-xs font-medium text-[#7ee09e]">
        {integration.transportLabel}
      </span>
    </div>
    <p class="mt-4 text-base leading-relaxed text-zinc-400 sm:text-xl">
      {integration.tagline}
    </p>
  </header>

  <section class="mt-12">
    <IntegrationDiagram integration={integration} />
  </section>

  <section class="mt-10 grid gap-4 lg:grid-cols-2">
    {integration.steps.map((step) => (
      <CodeBlock client:visible code={step.code} lang={step.lang} title={step.title} />
    ))}
  </section>

  <section class="mt-10 rounded-[24px] border border-white/[0.08] bg-[#1c1c1f] p-7">
    <h2 class="flex items-center gap-2.5 text-lg font-medium text-white">
      <span class="size-2 rounded-full bg-[#58cc7d]" aria-hidden="true"></span>
      <span>Why pair memtwig with {integration.name}</span>
    </h2>
    <ul class="mt-4 space-y-2.5 text-sm leading-relaxed text-zinc-400 sm:text-base">
      {integration.highlights.map((item) => (
        <li class="flex items-start gap-2.5">
          <span class="mt-2 size-1.5 shrink-0 rounded-full bg-[#58cc7d]" aria-hidden="true"></span>
          <span>{item}</span>
        </li>
      ))}
    </ul>
  </section>

  <section class="mt-10">
    <h2 class="text-sm font-medium text-zinc-400">More integrations</h2>
    <div class="mt-3 flex flex-wrap gap-2">
      {others.map((item) => (
        <a
          href={`/integrations/${item.slug}`}
          class={cn(buttonVariants({ variant: "outline", size: "sm" }))}
        >
          {item.name}
        </a>
      ))}
    </div>
  </section>

  <div class="mt-12 flex flex-wrap gap-3">
    <a href="/#install" class={cn(buttonVariants({ size: "lg" }))}>Install v1.6.0</a>
    <a href="/mcp-memory" class={cn(buttonVariants({ variant: "outline", size: "lg" }))}>
      MCP Reference
    </a>
  </div>
</ArticleLayout>
