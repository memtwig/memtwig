---
import ArticleLayout from "@/layouts/ArticleLayout.astro";
import { integrations } from "@/data/integrations";
import { buttonVariants } from "@/components/ui/button";
import { cn } from "@/lib/utils";

const accents = ["#58cc7d", "#6bb5ff", "#d5a8f8", "#ebb85e", "#f09a7a"];
---

<ArticleLayout
  title="Integrations — Use memtwig with your AI agents"
  description="Connect memtwig to Hermes Agent, Grok Bot, OpenBot, T3 Code, Claude Code, Cursor, OpenAI Codex, and Antigravity using MCP and native per-turn hooks."
  path="/integrations"
>
  <header class="max-w-3xl">
    <h1 class="text-balance text-5xl font-medium leading-[1.04] tracking-[-0.04em] text-white sm:text-6xl">
      Use memtwig with any AI agent.
    </h1>
    <p class="mt-4 text-base leading-relaxed text-zinc-400 sm:text-xl">
      One curated Markdown vault layer shared across autonomous bots, orchestrators, and terminal coding tools.
    </p>
  </header>

  <section class="mt-12 grid gap-4 sm:grid-cols-2">
    {integrations.map((item, idx) => {
      const dot = accents[idx % accents.length];
      return (
        <a
          href={`/integrations/${item.slug}`}
          class="group flex flex-col justify-between rounded-[24px] border border-white/[0.08] bg-[#1c1c1f] p-7 transition-all duration-200 hover:-translate-y-0.5 hover:border-white/20"
        >
          <div>
            <div class="flex flex-wrap items-start justify-between gap-3">
              <div class="flex min-w-0 items-center gap-3">
                <span
                  class="flex size-9 shrink-0 items-center justify-center rounded-xl text-sm font-medium text-[#111312]"
                  style={`background-color: ${dot}`}
                  aria-hidden="true"
                >
                  {item.name.slice(0, 1)}
                </span>
                <div>
                  <h2 class="text-lg font-medium text-white">{item.name}</h2>
                  <span class="text-xs text-zinc-400">{item.maker}</span>
                </div>
              </div>
              <span class="rounded-full bg-white/[0.06] px-3 py-1 text-xs font-medium text-zinc-200">
                {item.transportLabel}
              </span>
            </div>
            <p class="mt-5 text-sm leading-relaxed text-zinc-400">{item.tagline}</p>
          </div>
          <div class="mt-6 text-sm font-medium text-zinc-300 transition-colors group-hover:text-white">
            Setup guide →
          </div>
        </a>
      );
    })}
  </section>

  <div class="mt-12 flex flex-wrap gap-3">
    <a href="/#install" class={cn(buttonVariants({ size: "lg" }))}>Install v1.5.0</a>
    <a href="/mcp-memory" class={cn(buttonVariants({ variant: "outline", size: "lg" }))}>
      Explore MCP Memory Server
    </a>
  </div>
</ArticleLayout>
